---
/*
 * MARKETING PAGE — the template behind the feature and solution pages.
 *
 * Its job in this design language is the RHYTHM. The bar's inner pages are a
 * stack of full-bleed colour bands, and the band edge is the only divider on
 * the page: cream fold → colour → cream → colour → cream → violet close. That
 * cadence is assigned here rather than inside each block, so no page can drift
 * out of it and no block has to guess what it is sitting next to.
 *
 * The accent hue rotates per page (the bar is electric on home and pricing,
 * lilac on accounting, orange on payments) but the accent's JOB never rotates:
 * it is the hero pill and nothing else. It is derived from the slug so all
 * ~300 pages get a stable hue without a single content file being touched.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/blocks/Breadcrumbs.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import FeatureGrid from '@/components/blocks/FeatureGrid.astro';
import FeatureSplit from '@/components/blocks/FeatureSplit.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import SocialProof from '@/components/blocks/SocialProof.astro';
import RelatedLinks from '@/components/blocks/RelatedLinks.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { useTranslations, localizePath, type Locale } from '@/i18n';
import { graph, organization, softwareApplication, faqPage, breadcrumbList } from '@/lib/schema';
import { labelFor } from '@/lib/links';
import { allTerms } from '@/lib/glossary';

interface Props {
  locale: Locale;
  data: any;
  basePath: string; // e.g. "/features"
  section: { label: string; href: string }; // breadcrumb section
}
const { locale, data, basePath, section } = Astro.props;
const t = useTranslations(locale);

const path = `${basePath}/${data.slug}`;
const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: section.label, url: section.href },
  { name: data.title },
];

const faqs = (data.faqs || []).map((f: any) => ({ q: f.q, a: f.a }));
/* Labels are looked up per locale, never rebuilt from the slug: the old
   title-cased-slug path printed English labels ("Hr Payroll") on the ar, hi,
   bn and ur copies of every one of these pages. */
const related = await Promise.all(
  (data.related || []).map(async (href: string) => ({ href, title: await labelFor(href, locale, t) }))
);

/*
 * Glossary cross-links. The product pages and the glossary are two halves of
 * the same subject and neither linked the other, so the glossary's 77 pages
 * had inbound links only from their own hub. Terms are chosen by matching this
 * page's own keywords and title against the term names, which keeps the block
 * genuinely contextual rather than a rotating link dump; if nothing matches
 * the block does not render at all.
 */
const haystack = `${data.title} ${data.keywords ?? ''} ${data.heroSubtitle ?? ''}`.toLowerCase();
const glossaryTerms = allTerms(locale);
const enTerms = allTerms('en');
const scored = glossaryTerms
  .map((term, i) => {
    const en = enTerms[i];
    const needles = [en.slug.replace(/-/g, ' '), en.term.toLowerCase(), ...(en.abbr ? [en.abbr.toLowerCase()] : [])];
    const hit = needles.some((n) => n.length > 3 && haystack.includes(n));
    return hit ? term : null;
  })
  .filter(Boolean)
  .slice(0, 6) as typeof glossaryTerms;

/* One stable hue per page, spent only on the hero pill. */
const ACCENTS = ['electric', 'violet', 'copper'] as const;
const hash = [...String(data.slug ?? '')].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const accent = ACCENTS[hash % ACCENTS.length];

/* The band cadence. Splits cycle cream → periwinkle → white so consecutive
 * sections always separate, and the FAQ takes whichever neutral the last
 * split did not, so those two never abut on the same colour. */
const SPLIT_BANDS = ['paper', 'peri', 'white'] as const;
const VARIANTS = ['table', 'stats', 'doc'] as const;
const sections = data.sections || [];
const lastSplitBand = sections.length ? SPLIT_BANDS[(sections.length - 1) % SPLIT_BANDS.length] : 'sky';
const faqBand = lastSplitBand === 'paper' ? 'white' : 'paper';

const jsonld = [
  graph(
    organization(),
    softwareApplication(),
    breadcrumbList(crumbs.map((c) => ({ name: c.name, url: c.url ?? path })))
  ),
];
if (faqs.length) jsonld.push(graph(faqPage(faqs)));
---

<BaseLayout
  {locale}
  {path}
  title={data.metaTitle}
  description={data.metaDescription}
  keywords={data.keywords}
  {jsonld}
>
  <Breadcrumbs
    {locale}
    crumbs={[{ name: t('nav.home'), href: '/' }, { name: section.label, href: section.href }, { name: data.title }]}
  />

  <PageHero
    {locale}
    as="h1"
    {accent}
    eyebrow={data.heroEyebrow}
    title={data.heroTitle}
    subtitle={data.heroSubtitle}
    bullets={data.heroBullets}
    secondaryCta={{ href: '/pricing', label: t('nav.pricing') }}
  />

  <SocialProof {locale} compact />

  {data.features && data.features.length > 0 && <FeatureGrid features={data.features} band="sky" />}

  {sections.map((s: any, i: number) => (
    <FeatureSplit
      eyebrow={s.eyebrow}
      title={s.title}
      body={s.body}
      items={s.items}
      flip={i % 2 === 1}
      band={SPLIT_BANDS[i % SPLIT_BANDS.length]}
      variant={VARIANTS[i % VARIANTS.length]}
    />
  ))}

  {faqs.length > 0 && (
    <FaqAccordion
      title={data.faqTitle || t('faqSection.title')}
      eyebrow={t('faqSection.eyebrow')}
      faqs={faqs}
      band={faqBand}
    />
  )}

  {scored.length > 0 && (
    <section class="band band-surface band-tight" aria-labelledby="mp-terms">
      <div class="container-wide">
        <h2 id="mp-terms" class="font-display text-2xl text-ink-500 md:text-3xl">{t('related.termsTitle')}</h2>
        <ul class="mt-8 grid gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
          {scored.map((term) => (
            <li class="border-t border-ink-200">
              <a href={localizePath(`/glossary/${term.slug}`, locale)} class="group block py-5 no-underline">
                <span class="block font-semibold text-ink-500 group-hover:text-electric-500">{term.term}</span>
                <span class="mt-1 block text-sm leading-relaxed text-ink-500/70">{term.short}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8">
          <a href={localizePath('/glossary', locale)} class="font-semibold text-ink-500">{t('glossary.browseAll')}</a>
        </p>
      </div>
    </section>
  )}

  <RelatedLinks {locale} title={t('related.title')} links={related} band="tint" />

  <CtaBand {locale} title={data.ctaTitle} sub={data.ctaSub} />
</BaseLayout>
