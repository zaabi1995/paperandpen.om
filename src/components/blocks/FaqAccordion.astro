---
/*
 * FAQ ACCORDION — the bar's two-column FAQ.
 *
 * The bar sets the heading in the LEFT column and stacks the questions in a
 * wide right column: no pills, no boxed rows, no card around the list. Each
 * row is a bold question with a thin rule under it and a ⊕ on the outer edge;
 * the rule is the only structure on screen.
 *
 * Kept from the old version: `<details>/<summary>`, so the whole thing is
 * keyboard operable and open-by-default-crawlable with no JavaScript at all,
 * and the `as` prop, so /faq can make this list its page <h1>.
 */
type Band = 'paper' | 'white' | 'sky' | 'peri' | 'tint';

interface Faq {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  eyebrow?: string;
  faqs: Faq[];
  bg?: 'white' | 'cream';
  band?: Band;
  as?: 'h1' | 'h2';
}
const { title, eyebrow, faqs, bg, band, as = 'h2' } = Astro.props;
const Heading = as;

const resolved: Band = band ?? (bg === 'white' ? 'white' : 'paper');
const BAND: Record<Band, string> = {
  paper: 'band-paper',
  white: 'band-surface',
  sky: 'band-sky',
  peri: 'band-peri',
  tint: 'band-tint',
};

/* A page whose <h1> this is gets the full display scale; a section heading
   inside a longer page stays a step down. */
const headingSize = as === 'h1' ? 'text-display' : 'text-display-sm';

/* The rule between rows is the only structure in this block, so it has to be
 * visible on whatever ground it lands on. The warm paper hairline measures
 * 1.03 : 1 on the sky band and 1.14 : 1 on the grey one — it disappears
 * entirely. These clear the 3 : 1 bar for a non-text boundary on each band. */
const RULE: Record<Band, string> = {
  paper: 'border-ink-200', //  3.17 : 1
  white: 'border-ink-200', //  3.46 : 1
  tint: 'border-ink-200', //  3.02 : 1
  sky: 'border-ink-300', //  3.98 : 1
  peri: 'border-ink-500', //  6.96 : 1
};
const rule = RULE[resolved];
const eyebrowClass = resolved === 'peri' ? 'eyebrow-ink' : 'eyebrow';
---

<section class={`band ${BAND[resolved]}`}>
  <div class="container-wide grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      {eyebrow && <p class={`${eyebrowClass} mb-4`}>{eyebrow}</p>}
      <Heading class={`font-display ${headingSize} text-ink-500`}>{title}</Heading>
    </div>

    <div>
      {faqs.map((f) => (
        <details class={`faq-row group border-b ${rule} open:border-electric-500`}>
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-bold leading-snug text-ink-500"
          >
            <span>{f.q}</span>
            <span
              class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-ink-500 text-ink-500 transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                ><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg
              >
            </span>
          </summary>
          <div class="max-w-[62ch] pb-7 pe-10 text-base leading-relaxed text-ink-500">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Safari still paints its own disclosure triangle without this. */
  .faq-row > summary::-webkit-details-marker {
    display: none;
  }
  .faq-row > summary::marker {
    content: '';
  }
</style>
