const set = SHAPES[variant] ?? SHAPES.underline;
const shape = set[((seed % set.length) + set.length) % set.length];
const fill = FILL[color] ?? FILL.violet;

const wrapped = Astro.slots.has('default');

/* Class strategy differs by mode, on purpose:
 *   wrapped — the placement class always stays (it is what makes the doodle
 *     find the word), and `class` is appended for tweaks like `translate-y-1`.
 *   free — `class` REPLACES the default size. Tailwind resolves conflicting
 *     utilities by stylesheet order, not attribute order, so shipping `w-14`
 *     alongside a caller's `w-24` would be a coin toss. */
const placement = wrapped ? [shape.attach, cls] : [cls ?? shape.free];
const svgClass = ['pnp-doodle', ...placement, flip && 'pnp-doodle--flip', draw && 'pnp-doodle--draw']
  .filter(Boolean)
  .join(' ');
