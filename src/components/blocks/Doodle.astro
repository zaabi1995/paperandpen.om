  violet: '#7c3aed',
  electric: '#1650ee',
  ink: '#0d1b5e',
  emerald: '#047857',
  copper: '#a8500b',
  paper: '#f9f4f1', // for doodles sitting on the navy footer band
  current: 'currentColor',
};

