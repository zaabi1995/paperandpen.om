/*
 * Doodle — the hand-drawn accents.
 *
 * This is the bar's single most distinctive move and the easiest thing to lose:
 * a purple squiggle under one italic word, a curved arrow pointing at a badge.
 *
 * WHY THESE ARE FILLED PATHS, NOT STROKES
 * A real marker has UNEVEN WEIGHT — it swells through the middle of a stroke and
 * thins where the nib lands and lifts. `stroke-width` is constant by definition,
 * so a stroked path always reads as a geometric rule no matter how wobbly its
 * curve is. Every path below is instead a closed OUTLINE generated by walking a
 * wobbling centreline and offsetting it by a varying half-width, so the weight
 * genuinely changes along the stroke and the ends taper. (Generator:
 * `.gauntlet/` scratch — the output is committed here, there is no build step.)
 *
 * USAGE
 *   Wrap a word (the signature move — positions itself, no CSS at the call site):
 *     <h1>Plans to make your plans <Doodle variant="underline">happen</Doodle></h1>
 *   Free-floating (caller positions it):
 *     <Doodle variant="arrow" color="ink" class="absolute -top-8 w-14 h-14" />
 *
 * NOTES
 *   - Always aria-hidden. A doodle is decoration; it never carries meaning, so
 *     its contrast is not a text requirement and it needs no translation.
 *   - `seed` picks between hand-drawn alternates so two doodles on one page do
 *     not look photocopied.
 *   - RTL mirrors the stroke so it reads as drawn right-to-left; the arrow in
 *     particular MUST flip or it points against the reading direction.
 *   - The draw-on animation is pure CSS clip-path (no layout shift, no JS) and
 *     is disabled under prefers-reduced-motion.
 */

type Variant = 'underline' | 'circle' | 'arrow' | 'bracket';
type Colour = 'violet' | 'electric' | 'ink' | 'emerald' | 'copper' | 'paper' | 'current';

interface Props {
  /** underline = squiggle under a word · circle = loop around it ·
   *  bracket = under-brace beneath a phrase · arrow = free-floating pointer */
  variant?: Variant;
  /** Token colours. `current` inherits via currentColor. */
  color?: Colour;
  /** Alternate hand-drawn takes of the same shape. */
  seed?: number;
  /** Mirror horizontally (relative to the current writing direction). */
  flip?: boolean;
  /** Draw-on animation. Ignored under prefers-reduced-motion. */
  draw?: boolean;
  /** Overrides the default size/position classes entirely. */
  class?: string;
}

const {
  variant = 'underline',
  color = 'violet',
  seed = 0,
  flip = false,
  draw = true,
  class: cls,
} = Astro.props;

/* Token values, mirrored from tailwind.config.js. violet-500 is the decorative
 * squiggle stroke the token file reserves for exactly this. */
