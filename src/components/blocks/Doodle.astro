{wrapped ? (
  <span class="pnp-doodle-wrap">
    <slot />
    <svg class={svgClass} viewBox={shape.box} preserveAspectRatio={shape.par} fill={fill} aria-hidden="true" focusable="false">
      {shape.d.map((d) => <path d={d} />)}
    </svg>
  </span>
) : (
  <svg class={svgClass} viewBox={shape.box} preserveAspectRatio={shape.par} fill={fill} aria-hidden="true" focusable="false">
    {shape.d.map((d) => <path d={d} />)}
  </svg>
)}

<style>
  /* The wrapper hugs the word so the doodle can size itself to it.
     `line-height: 1` is load-bearing, not tidying: an inline-block's height is
     its own line box, so without it the doodle's `bottom` offset is measured
     from a box that grows with whatever leading the heading happens to use —
     the same squiggle then sat on the baseline in an h1 (0.95) and floated far
     below it in body copy (1.6). Pinning the wrapper's own line-height makes
     every offset below depend on font-size alone. */
  .pnp-doodle-wrap {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    line-height: 1;
  }

  .pnp-doodle {
    pointer-events: none;
    overflow: visible;
  }

  /* --- attached placements. All offsets are in `em`, so a doodle scales with
     the headline it belongs to and needs no per-breakpoint tuning. --- */
  /* Offsets measured against the capture: the bar's squiggle sits ON the
     baseline and crosses the descenders rather than clearing them. */
  .pnp-doodle--under {
    position: absolute;
    inset-inline: -0.05em;
    bottom: 0;
    height: 0.2em;
    width: auto;
  }
  .pnp-doodle--brace {
    position: absolute;
    inset-inline: -0.02em;
    bottom: -0.16em;
    height: 0.26em;
    width: auto;
  }
  .pnp-doodle--around {
    position: absolute;
    inset: -0.24em -0.42em;
    height: auto;
    width: auto;
  }
  /* An arrow is a pointer, not a text decoration — when it wraps a word it sits
     off the leading edge rather than under it. */
  .pnp-doodle--point {
    position: absolute;
    inset-inline-start: -1.35em;
    top: -0.9em;
    width: 1.1em;
    height: 1.1em;
  }

  /* RTL: mirror so the stroke reads as drawn right-to-left. `flip` is relative
     to the current direction, so the two compose (and cancel, correctly). */
  :global(html[dir='rtl']) .pnp-doodle {
    transform: scaleX(-1);
  }
  .pnp-doodle--flip {
    transform: scaleX(-1);
  }
  :global(html[dir='rtl']) .pnp-doodle--flip {
    transform: none;
  }

  /* Draw-on. clip-path never affects layout, so this cannot shift the page.
     The end state uses a NEGATIVE inset so the tapered tip is not clipped.
     In RTL the mirroring transform is applied after the clip, so the same
     keyframes reveal from the reading-start edge in both directions. */
  @media (prefers-reduced-motion: no-preference) {
    .pnp-doodle--draw {
      animation: pnp-doodle-draw 0.55s cubic-bezier(0.33, 0, 0.2, 1) 0.22s both;
    }
    @keyframes pnp-doodle-draw {
      from {
        clip-path: inset(-20% 100% -20% -10%);
      }
      to {
        clip-path: inset(-20% -10% -20% -10%);
      }
    }
  }
</style>
