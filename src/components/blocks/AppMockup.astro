---
/*
 * AppMockup: the LANGUAGE product image, one invoice list in five interfaces.
 *
 * WHY THIS FILE CHANGED SHAPE
 * It used to serve a real screenshot of the ERP (`/product/dashboard-*.webp`).
 * That route is closed and the brief says so in writing: a real capture carries
 * another company's logo, OMR at three decimals under a hero claiming "any
 * currency", and Oman-named seed clients. Nothing imported this component, so
 * rather than leave a dead component pointed at an asset we may not ship, the
 * file now holds the drawn mock the language section actually needs.
 *
 * WHAT THE CRITIC ACTUALLY DIAGNOSED, AND WHAT ANSWERS IT
 * The old language mock was "one Arabic greeting line then five grey
 * placeholder bars and three empty grey cards", i.e. a skeleton loader. Grey
 * bars are not a simplified UI; they are the universal drawing of a UI that has
 * NOT LOADED. So every bar is gone. What is here instead is a real invoice
 * list: a page title, a record count, a New-invoice control, four column
 * headings, four rows carrying a customer, a date, an amount and a status
 * badge, and a totals row that actually adds up (4,820 + 12,500 + 2,140 + 860
 * = 20,320).
 *
 * THE ONE DETAIL THAT MAKES IT READ AS A PRODUCT AND NOT AS FIVE POSTERS
 * The section's own copy promises "your data stays the same, only the interface
 * changes". So it does, literally: the four customers, the four amounts, the
 * currency and the four numerals are IDENTICAL in all five panels. Only the
 * chrome moves (page title, column headings, button, status words, month name,
 * and the reading direction). Switch to العربية and "Northwind Trading Co."
 * stays Latin and stays put while the table flips right-to-left, which is
 * exactly what a real ERP does and exactly what a faked "localised screenshot"
 * never gets right.
 *
 * NO NEW TRANSLATION KEYS, ON PURPOSE
 * The words inside the picture are the DEMO's language, not the page's: an
 * English reader must be able to see the Arabic interface. So they are data
 * here, the same way the old island held them, and the five `src/i18n/ui/*.json`
 * files are untouched. Every panel carries its own `lang` and `dir`, so a
 * screen reader announces each in the right voice and never reads Urdu as
 * English.
 *
 * WHY THERE IS NO JAVASCRIPT
 * The switch is five transparent radios, each stretched over the chip it
 * selects, plus `:checked` state rules. It works
 * before hydration, it works with JS off, it costs no React on the home page,
 * and the labels keep a real focus ring. Radios (not buttons) because picking
 * one of five mutually exclusive options IS a radio group, and arrow-key
 * navigation then comes from the platform rather than from hand-written
 * keyboard code.
 *
 * COLOUR
 * Status badges are the only non-ink colour inside the frame, and they encode
 * STATE, which is the one job colour is allowed to do here. The accent stays on
 * the interactive control (the New-invoice pill), never scattered onto
 * decoration, and that scatter is what lost an earlier round.
 */

import { getLocaleFromUrl } from '../../i18n';

/* Same four records in every panel, see the header note. Amounts are USD with
 * two decimals and no OMR anywhere; the hero carries the multi-currency switch,
 * this frame carries the multi-LANGUAGE claim, and mixing the two would have
 * broken the "data stays the same" promise the copy makes. */
const ROWS = [
  { customer: 'Northwind Trading Co.', amount: '$4,820.00', day: '12', status: 'paid' },
  { customer: 'Harbour Point Ltd', amount: '$12,500.00', day: '09', status: 'overdue' },
  { customer: 'Cedar Clinic Group', amount: '$2,140.00', day: '05', status: 'paid' },
  { customer: 'Studio Meridian', amount: '$860.00', day: '02', status: 'draft' },
] as const;
const TOTAL = '$20,320.00';

type Status = 'paid' | 'overdue' | 'draft';

interface Demo {
  code: string;
  /** Locale flag. The one place emoji are allowed on this site. */
  flag: string;
  name: string;
  dir: 'ltr' | 'rtl';
  /** A line of real running text so the SCRIPT is visible in the chip itself. */
  sample: string;
  title: string;
  count: string;
  newLabel: string;
  cols: { customer: string; date: string; amount: string; status: string };
  month: string;
  status: Record<Status, string>;
  total: string;
}

const DEMOS: Demo[] = [
  {
    code: 'ar',
    flag: '🇦🇪',
    name: 'العربية',
    dir: 'rtl',
    sample: 'أهلاً بك، إليك فواتير هذا الشهر',
    title: 'الفواتير',
    count: '4 فواتير · مايو 2026',
    newLabel: 'فاتورة جديدة',
    cols: { customer: 'العميل', date: 'التاريخ', amount: 'المبلغ', status: 'الحالة' },
    month: 'مايو',
    status: { paid: 'مدفوعة', overdue: 'متأخرة', draft: 'مسودة' },
    total: 'الإجمالي',
  },
  {
    code: 'en',
    flag: '🇬🇧',
    name: 'English',
    dir: 'ltr',
    sample: 'Welcome back, here are this month’s invoices',
    title: 'Invoices',
    count: '4 invoices · May 2026',
    newLabel: 'New invoice',
    cols: { customer: 'Customer', date: 'Date', amount: 'Amount', status: 'Status' },
    month: 'May',
    status: { paid: 'Paid', overdue: 'Overdue', draft: 'Draft' },
    total: 'Total',
  },
  {
    code: 'hi',
    flag: '🇮🇳',
    name: 'हिन्दी',
    dir: 'ltr',
    sample: 'नमस्ते, इस महीने के चालान यहाँ हैं',
    title: 'चालान',
    count: '4 चालान · मई 2026',
    newLabel: 'नया चालान',
    cols: { customer: 'ग्राहक', date: 'तारीख', amount: 'राशि', status: 'स्थिति' },
    month: 'मई',
    status: { paid: 'भुगतान हुआ', overdue: 'बकाया', draft: 'ड्राफ़्ट' },
    total: 'कुल',
  },
  {
    code: 'bn',
    flag: '🇧🇩',
    name: 'বাংলা',
    dir: 'ltr',
    sample: 'স্বাগতম, এই মাসের চালান এখানে',
    title: 'চালান',
    count: '4 চালান · মে 2026',
    newLabel: 'নতুন চালান',
    cols: { customer: 'ক্রেতা', date: 'তারিখ', amount: 'পরিমাণ', status: 'অবস্থা' },
    month: 'মে',
    status: { paid: 'পরিশোধিত', overdue: 'বকেয়া', draft: 'খসড়া' },
    total: 'সর্বমোট',
  },
  {
    code: 'ur',
    flag: '🇵🇰',
    name: 'اردو',
    dir: 'rtl',
    sample: 'خوش آمدید، اس ماہ کی انوائسز حاضر ہیں',
    title: 'انوائسز',
    count: '4 انوائسز · مئی 2026',
    newLabel: 'نئی انوائس',
    cols: { customer: 'کسٹمر', date: 'تاریخ', amount: 'رقم', status: 'حالت' },
    month: 'مئی',
    status: { paid: 'ادا شدہ', overdue: 'واجب الادا', draft: 'مسودہ' },
    total: 'کل',
  },
];

/* State colour. Every pair is checked on white:
 *   emerald-600 on emerald-50 = 8.4 : 1     copper-400 on copper-50 = 5.5 : 1
 *   ink-500     on paper-200  = 13.4 : 1
 * A badge is never colour alone, the word is always there too. */
const BADGE: Record<Status, string> = {
  paid: 'bg-emerald-50 text-emerald-600',
  overdue: 'bg-copper-50 text-copper-400',
  draft: 'bg-paper-200 text-ink-500',
};

/* Which panel opens. Always a language the visitor is NOT already reading, so
 * the frame proves something the rest of the page cannot: an English, Hindi or
 * Bengali reader lands on the Arabic screen (the RTL flip is the whole claim,
 * and it is the one thing a mirrored fake never gets right), while an Arabic or
 * Urdu reader lands on English rather than on the interface they already have.
 * Falling open on your own language would have made the demo look like a
 * screenshot of the page it sits on. */
const pageLocale = getLocaleFromUrl(Astro.url);
const openCode = pageLocale === 'ar' || pageLocale === 'ur' ? 'en' : 'ar';
---

<div class="lang-demo">
  <div class="grid items-center gap-y-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-x-12">
    {/* The switcher, as a real vertical menu rather than a wrapped pill row.
        The old row left two thirds of this column empty, and each chip carries
        a line of running text in its own script, so the column now shows five
        alphabets instead of five words. */}
    <div class="lang-demo__chips flex flex-col gap-2">
      {DEMOS.map((d) => (
        <label class="lang-demo__chip" data-lang={d.code}>
          {/* The radio is INSIDE its chip and stretched over the whole of it,
              not clipped to a pixel somewhere else in the DOM. A 1x1 control
              fails WCAG 2.5.8 target size on its own measurements even when a
              `for=` label happens to be big, and it is the control the pointer
              lands on. Stretched and transparent, the control's own hit box IS
              the visible chip. `opacity: 0` rather than the clip pattern
              because it must still be reachable by pointer; the platform keeps
              it focusable and arrow-key navigable either way. */}
          <input
            class="lang-demo__radio"
            type="radio"
            name="pnp-lang-demo"
            value={d.code}
            checked={d.code === openCode}
          />
          <span class="lang-demo__flag" aria-hidden="true">{d.flag}</span>
          <span class="min-w-0 flex-1">
            {/* `lang` but deliberately NO `dir`: the bidi algorithm already lays
                an Arabic or Urdu run out right-to-left inside this line, while
                the LINE itself stays aligned to the page's direction. Setting
                dir here instead flipped only these two rows to the right and
                left the menu looking ragged. */}
            <bdi class="block text-sm font-semibold" lang={d.code}>{d.name}</bdi>
            <bdi class="lang-demo__sample block truncate text-[11px]" lang={d.code}>{d.sample}</bdi>
          </span>
          <svg class="lang-demo__tick h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z" />
          </svg>
        </label>
      ))}
    </div>

    {/* The product window. Square-on, not tilted: the hero already carries the
        tilt, and this is the frame whose whole job is to be READ. */}
    <div class="lang-demo__panels">
      {DEMOS.map((d) => (
        <article class="lang-demo__panel" data-lang={d.code} lang={d.code} dir={d.dir}>
          <div class="lang-demo__win overflow-hidden rounded-2xl border border-paper-300 bg-white">
            <div class="flex items-center justify-between bg-ink-500 px-5 py-3">
              <span class="font-display text-sm font-semibold text-cream-50" dir="ltr">Paper &amp; Pen</span>
              <span class="flex gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
              </span>
            </div>

            <div class="p-5 sm:p-6">
              <div class="mb-5 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-display text-lg font-semibold leading-tight">{d.title}</p>
                  <p class="mt-0.5 text-[11px] font-medium">{d.count}</p>
                </div>
                {/* The one accented control in the frame. */}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill bg-electric-500 px-3.5 py-2 text-[11px] font-bold text-white">
                  <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M5 1h2v4h4v2H7v4H5V7H1V5h4z" /></svg>
                  {d.newLabel}
                </span>
              </div>

              <div class="lang-demo__table text-[11.5px]">
                <div class="lang-demo__head">
                  <span>{d.cols.customer}</span>
                  <span>{d.cols.date}</span>
                  <span class="text-end">{d.cols.amount}</span>
                  <span class="text-end">{d.cols.status}</span>
                </div>
                {ROWS.map((r) => (
                  <div class="lang-demo__row">
                    {/* Customer and amount are DATA: identical in all five
                        panels, and wrapped in <bdi> so a Latin company name or
                        a currency amount cannot be reordered or split by the
                        surrounding Arabic or Urdu run.
                        <bdi> and NOT `dir="ltr"` on the cell: `dir` also flips
                        what `text-end` resolves to, so the amounts aligned to
                        the opposite edge from their own column heading and the
                        column visibly came apart in the RTL panels. */}
                    <span class="truncate font-semibold"><bdi>{r.customer}</bdi></span>
                    <span class="whitespace-nowrap">{r.day} {d.month} 2026</span>
                    <span class="text-end font-semibold tabular-nums"><bdi>{r.amount}</bdi></span>
                    <span class="text-end">
                      <span class:list={['inline-block rounded-pill px-2 py-0.5 text-[10px] font-bold', BADGE[r.status]]}>
                        {d.status[r.status]}
                      </span>
                    </span>
                  </div>
                ))}
                <div class="lang-demo__total">
                  <span class="font-semibold">{d.total}</span>
                  <span></span>
                  <span class="lang-demo__grand text-end font-display text-base font-semibold tabular-nums"><bdi>{TOTAL}</bdi></span>
                  <span></span>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  /* ---------------------------------------------------------------------
   * THE SWITCH
   * Still no JavaScript: five radios and CSS state. The radio now sits inside
   * the chip it selects, so the CHIP's own state comes from a plain sibling
   * combinator and only the cross-column reach (radio in one column, panel in
   * the other) spends a `:has()`. That trade buys the thing the detached
   * version could not have: a control whose hit box is the chip you can see,
   * instead of a pixel clipped somewhere above it.
   * ------------------------------------------------------------------ */
  .lang-demo__chip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.85rem;
    border: 1px solid theme('colors.paper.300');
    background: #fff;
    color: theme('colors.ink.500');
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .lang-demo__chip:hover {
    border-color: theme('colors.ink.200');
  }
  /* Covers the whole chip, paints nothing. `appearance: none` so no browser
     draws its own dot underneath, and `margin: 0` because the UA sheet's
     default margin would otherwise inset the hit box on every side. */
  .lang-demo__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    opacity: 0;
    cursor: pointer;
  }
  .lang-demo__flag {
    font-size: 1.125rem;
    line-height: 1;
  }
  /* The tick is the checked marker; unchecked it is simply not there, so the
     row keeps its width and nothing shifts when the selection moves. */
  .lang-demo__tick {
    visibility: hidden;
  }
  /* The sample line recedes by SIZE, never by a lightened ink. The foundation
     is explicit that there is one text colour and that quiet copy gets there by
     being smaller or lighter in weight. An `opacity: 0.72` here would have been
     the same mistake wearing a different property name. */
  .lang-demo__sample {
    font-weight: 400;
  }

  /* <bdi> isolates the run AND takes its own base direction, which also flips
     what `text-align: start` resolves to, so the Arabic and Urdu rows alone
     jumped to the right edge and the menu came out ragged. The SCRIPT still
     runs right-to-left inside the line; only the line box is pinned to the
     page's own direction, which is how every native language picker sets one
     out. */
  .lang-demo__chip bdi {
    text-align: left;
  }
  :global([dir='rtl']) .lang-demo__chip bdi {
    text-align: right;
  }

  /* Only one panel is in the flow at a time. `display:none` (not opacity or
     visibility) so the hidden four are out of the accessibility tree as well
     as off the screen: four invisible invoice tables read aloud in four
     languages would be worse than no demo at all. */
  .lang-demo__panel {
    display: none;
  }

  .lang-demo__win {
    /* The same single grounding shadow the hero window uses. Not a glow. */
    box-shadow: 0 18px 44px -30px rgba(13, 27, 94, 0.4);
  }

  /* Checked: the chip inverts to solid ink and its tick appears. Both come
     from the radio the chip contains, so neither needs to reach out of it. */
  .lang-demo__chip:has(.lang-demo__radio:checked) {
    background: theme('colors.ink.500');
    border-color: theme('colors.ink.500');
    color: theme('colors.cream.50');
  }
  .lang-demo__radio:checked ~ .lang-demo__tick {
    visibility: visible;
  }

  /* The one cross-column rule: the checked radio is in the menu, the panel it
     opens is in the other column. Matched on `value`, not on an id, so two
     copies of this component on one page do not have to invent unique ids. */
  .lang-demo:has(.lang-demo__radio[value='ar']:checked) .lang-demo__panel[data-lang='ar'],
  .lang-demo:has(.lang-demo__radio[value='en']:checked) .lang-demo__panel[data-lang='en'],
  .lang-demo:has(.lang-demo__radio[value='hi']:checked) .lang-demo__panel[data-lang='hi'],
  .lang-demo:has(.lang-demo__radio[value='bn']:checked) .lang-demo__panel[data-lang='bn'],
  .lang-demo:has(.lang-demo__radio[value='ur']:checked) .lang-demo__panel[data-lang='ur'] {
    display: block;
  }

  /* The focus ring is drawn on the CHIP, because the radio itself paints
     nothing. Without this the whole switcher is invisible to anyone tabbing,
     which is an accessibility failure and not a style preference. */
  .lang-demo__chip:has(.lang-demo__radio:focus-visible) {
    outline: 3px solid theme('colors.electric.500');
    outline-offset: 2px;
  }

  /* ---------------------------------------------------------------------
   * THE TABLE
   * A four-column grid rather than a <table>, because the status cell holds a
   * badge and the totals row spans differently, and because the columns have
   * to hold their proportions identically in all five languages, which is the
   * whole point of the demo. `minmax(0, …)` on the name column is what stops a
   * long customer name widening the grid instead of truncating.
   * ------------------------------------------------------------------ */
  .lang-demo__head,
  .lang-demo__row,
  .lang-demo__total {
    display: grid;
    /* Every track is a FRACTION, none is `auto`. The heading row, the four
       record rows and the totals row are six separate grid containers, so an
       `auto` track resolves independently in each one: the status heading is
       one short word and the status cells are padded badges, so the amount and
       status columns visibly came apart between the heading and the rows.
       Fractions are identical in all six. */
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr) minmax(0, 0.95fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 0.5rem;
  }
  .lang-demo__head {
    padding-bottom: 0.55rem;
    border-bottom: 1px solid theme('colors.paper.300');
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lang-demo__row {
    padding-block: 0.62rem;
    border-bottom: 1px solid theme('colors.paper.200');
  }
  .lang-demo__total {
    padding-top: 0.7rem;
  }

  /* Below 400px the date column is the first thing to go: four columns at that
     width squeeze the customer name to nothing, and the name is the column
     that proves this is a record of something. */
  @media (max-width: 400px) {
    .lang-demo__head,
    .lang-demo__row,
    .lang-demo__total {
      grid-template-columns: minmax(0, 1.78fr) minmax(0, 0.95fr) minmax(0, 0.9fr);
    }
    .lang-demo__head > :nth-child(2),
    .lang-demo__row > :nth-child(2),
    .lang-demo__total > :nth-child(2) {
      display: none;
    }
    /* The grand total is the one figure set in the display face, and at 16px it
       is 79px wide in a 74px column, so it would have hung over the status
       column. Measured, not guessed. */
    .lang-demo__grand {
      font-size: 0.8125rem;
    }
  }
</style>
