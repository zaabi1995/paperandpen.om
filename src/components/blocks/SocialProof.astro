---
/*
 * SOCIAL PROOF — two modes.
 *
 * `compact` is the thin trust strip that sits directly under a page hero on
 * the same cream ground. It carries three CHECKABLE facts now, not a rating:
 * what is free, how many languages, and who builds it.
 *
 * The default mode is the stats row. It used to be four bordered cards with
 * copper numerals — boxes on boxes, plus the accent spent on decoration while
 * the page's CTA sat unaccented, which is precisely the mistake the brief
 * calls out. It is now flat on a band: no cards, no borders, no shadows, big
 * ink serif numerals, small labels. Electric stays reserved for actions and
 * price numerals, so it does not appear here at all.
 *
 * Two of the four stats used to be hardcoded ('5', and a literal 'OMR' that
 * made the row Oman-only). Both now read from the dictionary, so the row
 * translates and stays currency-neutral.
 */
import { useTranslations, type Locale } from '@/i18n';
interface Props {
  locale: Locale;
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const t = useTranslations(locale);

/*
 * r376. The first stat was a literal '4.9/5' beside 'Average customer rating',
 * and the compact strip below it carried five filled stars and '73 business
 * reviews'. There is no review corpus behind either number: no testimonial
 * surface, no third-party listing, and nothing a reader could check. The same
 * fabricated 4.9 / 73 pair was deleted from lib/schema.ts once already (see the
 * note at its softwareApplication builder), and it survived here because the
 * invented-claim linter only ever ran over GENERATED CONTENT and never over the
 * shared layout. scripts/verify.py now lints the rendered document, so this
 * cannot come back quietly.
 *
 * Every stat here is now a fact about the product that a reader can verify on
 * this site in one click.
 */
const stats = [
  { value: t('trust.stat2_value'), label: t('trust.stat2_label') },
  { value: t('trust.stat1_value'), label: t('trust.stat1_label') },
  { value: t('trust.stat3_value'), label: t('trust.stat3_label') },
  { value: t('trust.stat4_value'), label: t('trust.stat4_label') },
];
---

{
  compact ? (
    <div class="band-paper px-6 pb-2 pt-2">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-500">
        <span class="font-semibold">{t('proof.free')}</span>
        <span aria-hidden="true" class="hidden text-ink-200 sm:inline">·</span>
        <span>{t('proof.languages')}</span>
        <span aria-hidden="true" class="hidden text-ink-200 sm:inline">·</span>
        <span>{t('proof.builtInOman')}</span>
      </div>
    </div>
  ) : (
    <section class="band band-sky">
      <div class="container-narrow">
        <div class="grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4">
          {stats.map((s) => (
            <div class="text-center">
              <p class="font-display text-display-sm leading-none text-ink-500">{s.value}</p>
              <p class="mt-4 text-base leading-snug text-ink-500">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
