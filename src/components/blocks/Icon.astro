const d = PATHS[name] ?? PATHS.check;
const a11y = title ? { role: 'img' } : { 'aria-hidden': 'true' };
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
>
  {title && <title>{title}</title>}
  <path d={d} />
</svg>
