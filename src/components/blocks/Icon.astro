---
/*
 * Icon — one inline, stroke-based family. No sprite, no font, no request.
 *
 * FAMILY RULES (what makes this read as one set beside the doodles)
 *   - 24×24 grid, geometric construction, stroked only — never a filled glyph
 *     mixed in with outlined ones. That inconsistency is what makes an icon set
 *     look assembled from three sources.
 *   - ONE stroke weight, and it is heavier than a stock outline set. The page's
 *     type is a bold navy serif and the doodles are chunky marker strokes; a
 *     1.5 hairline icon read as a different, lighter product sitting next to
 *     them. 1.8 is the weight that matches.
 *   - Round caps and round joins everywhere, echoing the drawn accents.
 *   - One concept, one glyph. `quote` and `whatsapp` used to share a path, so a
 *     quotation and a chat message were indistinguishable; they are now
 *     distinct. Anything that means the same thing aliases deliberately
 *     (`hr` → `users`) rather than by accident.
 *
 * ACCESSIBILITY
 *   Decorative by default (`aria-hidden`). Pass `title` when the icon is the
 *   ONLY content of a control, and it becomes `role="img"` with a name.
 *   `title` is user-facing copy: it must come from i18n, never a literal.
 */
interface Props {
  name?: string;
  class?: string;
  /** Stroke weight override. Leave alone unless an icon sits at a huge size. */
  weight?: number;
  /** Accessible name. Supplying it un-hides the icon from assistive tech. */
  title?: string;
}
