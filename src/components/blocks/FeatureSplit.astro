---
/*
 * FEATURE SPLIT — copy on one side, product imagery on the other.
 *
 * The old version put a dark navy gradient card with a blurred copper glow and
 * a frosted-glass panel on a cream page: three effects the bar does not have
 * anywhere on it. The bar's split is flat — the screenshot sits DIRECTLY on
 * the band on a solid colour plate, bleeding off the outer edge, with one
 * small white callout overlapping it. There is no card around the image, no
 * shadow between it and the band, and no gradient.
 *
 * The imagery is the shared <AppMockup>, the same product mock the home page
 * hero uses, so one hand draws the product across the whole site. It is
 * wordless and currency-neutral by default, carries its own overflow safety
 * for the bleed, and is decorative (aria-hidden) — the copy beside it holds
 * the meaning.
 */
import AppMockup from './AppMockup.astro';

type Band = 'paper' | 'white' | 'sky' | 'peri' | 'tint';
type Variant = 'table' | 'stats' | 'doc';

interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  items?: string[];
  flip?: boolean;
  bg?: 'white' | 'cream';
  band?: Band;
  variant?: Variant;
}
const { eyebrow, title, body, items = [], flip = false, bg, band, variant = 'table' } = Astro.props;

const resolved: Band = band ?? (bg === 'cream' ? 'paper' : 'white');
const BAND: Record<Band, string> = {
  paper: 'band-paper',
  white: 'band-surface',
  sky: 'band-sky',
  peri: 'band-peri',
  tint: 'band-tint',
};

/* The violet eyebrow measures 3.14 : 1 on periwinkle and fails AA for text
 * that small; ink is 6.96 : 1 on the same band. */
const eyebrowClass = resolved === 'peri' ? 'eyebrow-ink' : 'eyebrow';

/* The flat colour plate behind the mock has to separate from the band it sits
 * on, so a sky plate never lands on the sky band and a periwinkle one never
 * lands on periwinkle. Within that, `variant` just rotates the choice so three
 * splits on one page do not look photocopied. */
const PLATES: Record<Band, readonly ['navy' | 'peri' | 'sky', 'navy' | 'peri' | 'sky', 'navy' | 'peri' | 'sky']> = {
  paper: ['peri', 'navy', 'sky'],
  white: ['peri', 'navy', 'sky'],
  tint: ['peri', 'navy', 'sky'],
  sky: ['navy', 'peri', 'navy'],
  peri: ['navy', 'sky', 'navy'],
};
const VARIANT_INDEX: Record<Variant, number> = { table: 0, stats: 1, doc: 2 };
const panel = PLATES[resolved][VARIANT_INDEX[variant] ?? 0];
---

<section class={`band ${BAND[resolved]} overflow-hidden`}>
  <div class="container-narrow grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div class={flip ? 'lg:order-2' : ''}>
      {eyebrow && <p class={`${eyebrowClass} mb-4`}>{eyebrow}</p>}
      <h2 class="font-display text-display-sm text-ink-500">{title}</h2>
      {body && <p class="lede mt-6">{body}</p>}
      {items.length > 0 && (
        <ul class="mt-8 space-y-4">
          {items.map((it) => (
            <li class="flex items-start gap-3.5">
              <span
                class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-violet-600 text-white"
                aria-hidden="true"
              >
                <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg
                >
              </span>
              <span class="text-base leading-relaxed text-ink-500">{it}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    {/* The product image. Bleeds off the outer edge on wide screens the way
        the bar's does; when the columns are flipped it stays put, because the
        outer edge is then on the text side. */}
    <div class={flip ? 'lg:order-1' : ''}>
      <AppMockup tilt="soft" bleed={flip ? 'none' : 'end'} {panel} float />
    </div>

  </div>
</section>
