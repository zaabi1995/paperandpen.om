---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import StickyCta from '@/components/blocks/StickyCta.astro';
import { isRTL, LOCALE_META, useTranslations, type Locale } from '@/i18n';
import { graph, organization, webSite } from '@/lib/schema';

export interface Props {
  title: string;
  description: string;
  path: string;
  locale: Locale;
  image?: string;
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  keywords?: string;
  alternateLocales?: readonly Locale[];
  noAlternates?: boolean;
  /** Hide chrome (nav/footer/sticky CTA) for bare pages like signup/login. */
  bare?: boolean;
}

const { locale, bare = false, ...seo } = Astro.props;

/*
 * The WebSite node belongs to the SITE, not to any one page, so it is emitted
 * here rather than repeated in ~20 page templates (where it would inevitably
 * end up on some and not others). Its SearchAction points at the glossary
 * index, which really does answer ?q= client-side; declaring a search endpoint
 * that does not exist is worse than declaring none.
 */
const baseGraph = graph(
  organization(),
  webSite({
    name: 'Paper & Pen',
    description: useTranslations(locale)('seo.homeDesc'),
    locale: LOCALE_META[locale].htmlLang,
    searchUrl: '/glossary/',
  })
);
const ORGANIZATION_ID = 'https://paperandpen.om/#organization';
const pageGraph = (seo.jsonld ?? []).map((document) => {
  const nodes = Array.isArray(document['@graph']) ? document['@graph'] : null;
  if (!nodes) return document;
  return {
    ...document,
    '@graph': nodes.filter((node) => {
      if (!node || typeof node !== 'object') return true;
      return (node as Record<string, unknown>)['@id'] !== ORGANIZATION_ID;
    }),
  };
});
const seoProps = { ...seo, jsonld: [...pageGraph, baseGraph] };
const dir = isRTL(locale) ? 'rtl' : 'ltr';
const htmlLang = LOCALE_META[locale].htmlLang;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={htmlLang} dir={dir} data-product="paperandpen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#172e50" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    {/* iOS will not render an SVG here: it silently falls back to a screenshot
        of the page. A real 180x180 PNG on an opaque ground is the only asset
        that works, and /favicon.ico is the root fallback a browser requests
        regardless of what the document declares. Both are generated from
        favicon.svg so all three agree. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/manifest.json" />

    {/* Fonts — fonts.bhd.om only (never Google). Loaded non-render-blocking. */}
    <link rel="preconnect" href="https://fonts.bhd.om" />
    <link rel="preconnect" href="https://fonts.bhd.om" crossorigin />
    {(() => {
      /* Display face is Source Serif 4: a moderate-contrast TRANSITIONAL serif.
         Playfair Display was dropped deliberately — it is a high-contrast didone
         and reads editorial-fashion rather than calm-financial. Source Serif 4 is
         variable (100-900, true italic, optical sizing) and fonts.bhd.om reports
         its licence as OFL-1.1 / Apache, the only serif candidate here with a
         licence clean enough for a public marketing site. */
      const FONTS = 'https://fonts.bhd.om/css2?family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600;700&family=IBM+Plex+Arabic:wght@400;500;600;700&display=swap';
      return (
        <>
          <link rel="preload" as="style" href={FONTS} />
          <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
          <noscript><link rel="stylesheet" href={FONTS} /></noscript>
        </>
      );
    })()}

    <Seo {...seoProps} locale={locale} />

    {/*
      r6-83. Three things have to be true together or the skip link measures
      present and behaves broken, and this site had none of them on 118 served
      documents: the link exists and is keyboard-reachable (clip technique),
      its target can take focus (tabindex="-1" on <main>, without which the
      anchor moves the scroll position but leaves focus on the link, so the
      next Tab walks straight back into the nav the user just asked to skip),
      and following it does not park the user under the sticky header
      (Navbar is `sticky top-0 z-50`, so scroll-padding-top).

      is:inline is deliberate. Astro would otherwise bundle this into a CSS
      file, and r6-85 is the four-times-reopened item that proves a promise
      riding a sheet a page may stop linking can go dark with nobody editing
      it. This block reaches every served page in its own markup because
      BaseLayout is the one owner every template routes through.
    */}
    <style is:inline>
      .skip-link{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
      .skip-link:focus{position:fixed;top:.75rem;left:.75rem;z-index:100;width:auto;height:auto;margin:0;padding:.75rem 1.25rem;clip:auto;clip-path:none;white-space:normal;background:#172e50;color:#fff;border-radius:9999px;font-weight:600;text-decoration:none;outline:3px solid #fff;outline-offset:2px}
      html[dir="rtl"] .skip-link:focus{left:auto;right:.75rem}
      html{scroll-padding-top:5rem}
    </style>
  </head>
  <body>
    {/*
      Bare pages hide the nav, so they have no repeated block to bypass and a
      skip link on them is noise rather than an aid. WCAG 2.4.1 is about
      bypassing REPEATED blocks, and the target keeps its id either way so the
      anchor is never dangling.
    */}
    {!bare && <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>}
    {!bare && <Navbar locale={locale} />}
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
    {!bare && <StickyCta locale={locale} />}

    {/* Reveal-on-scroll (progressive enhancement) */}
    <script>
      const els = document.querySelectorAll('.reveal');
      const revealAll = () => els.forEach((el) => el.classList.add('is-visible'));
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '200px 0px 200px 0px' }
        );
        els.forEach((el) => io.observe(el));
        // Safety net: never leave content hidden if the observer never fires.
        window.addEventListener('load', () => setTimeout(revealAll, 1500));
      } else {
        revealAll();
      }
    </script>
  </body>
</html>
