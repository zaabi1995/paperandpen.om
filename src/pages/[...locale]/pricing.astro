---
/*
 * /pricing — the flat-bands stack.
 *
 *   breadcrumbs
 *   PricingTable   ->  paper band (headline + toggle + cards)
 *                      pale-blue band (full feature comparison)
 *   FaqAccordion   ->  paper band
 *   CtaBand        ->  the closing CTA
 *
 * SocialProof is deliberately NOT on this page any more: its four stat tiles
 * are cream cards inside a white section (boxes on boxes, which the flat-band
 * language does not do), they are painted in copper, which is no longer an
 * accent, and one of the four is a bare "OMR" tile that reads the product as
 * Oman-only. The comparison table now carries far more proof than those tiles
 * did. See "concerns" if that component is wanted back here.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/blocks/Breadcrumbs.astro';
import PricingTable from '@/components/blocks/PricingTable.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { useTranslations, tRaw, type Locale } from '@/i18n';
import { localeStaticPaths } from '@/lib/paths';
import { graph, organization, product, faqPage, breadcrumbList } from '@/lib/schema';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqs = [
  { q: t('pricingFaq.q1'), a: t('pricingFaq.a1') },
  { q: t('pricingFaq.q2'), a: t('pricingFaq.a2') },
  { q: t('pricingFaq.q3'), a: t('pricingFaq.a3') },
];
const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.pricing'), url: '/pricing' },
];

/* Offers are read from the same dictionary the cards render from, so the
   structured data cannot drift away from the published price. */
const offers = (['free', 'growth', 'enterprise'] as const).map((key) => ({
  name: t(`pricing.${key}.name`),
  price: Number(tRaw(locale, `pricing.${key}.price_monthly`) ?? 0),
  currency: 'OMR',
}));

const jsonld = [
  graph(
    organization(),
    product({
      name: 'Paper & Pen ERP',
      description:
        'Free cloud ERP and invoicing with optional paid modules. One global price list, five languages, any currency.',
      offers,
    }),
    breadcrumbList(crumbs, locale)
  ),
  graph(faqPage(faqs)),
];
---

<BaseLayout
  {locale}
  path="/pricing"
  title={t('seo.pricingTitle')}
  description={t('seo.pricingDesc')}
  keywords="ERP pricing, free invoicing software pricing, affordable ERP, multi-currency ERP cost"
  {jsonld}
>
  <Breadcrumbs {locale} crumbs={[{ name: t('nav.home'), href: '/' }, { name: t('nav.pricing') }]} />
  <PricingTable {locale} />
  <FaqAccordion
    title={t('faqSection.title')}
    eyebrow={t('faqSection.eyebrow')}
    faqs={faqs}
    bg="cream"
  />
  <CtaBand {locale} />
</BaseLayout>
