---
import { getCollection } from 'astro:content';
import CountryVatPage from '@/components/templates/CountryVatPage.astro';
import { contentStaticPaths } from '@/lib/paths';
import type { Locale } from '@/i18n';

export async function getStaticPaths() {
  return contentStaticPaths(await getCollection('vat'));
}
const { data, locale } = Astro.props as { data: any; locale: Locale };
---
<CountryVatPage {locale} {data} />
