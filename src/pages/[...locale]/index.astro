---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialProof from '@/components/blocks/SocialProof.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import SubdomainChecker from '@/components/islands/SubdomainChecker.tsx';
import ModulePicker from '@/components/islands/ModulePicker.tsx';
import LangMock from '@/components/blocks/AppMockup.astro';
import { useTranslations, localizePath, isRTL, type Locale } from '@/i18n';
import { localeStaticPaths } from '@/lib/paths';
import { graph, organization, softwareApplication, faqPage } from '@/lib/schema';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
const rtl = isRTL(locale);

const compareCols = [t('compare.pp'), t('compare.zoho'), t('compare.odoo'), t('compare.tally'), t('compare.sowaan')];
const featKeys = ['arabic', 'gcc_pricing', 'free_trial', 'local_support', 'multi_lang', 'paymob', 'onboarding'];
const MATRIX: Record<string, boolean[]> = {
  arabic: [true, false, false, false, true],
  gcc_pricing: [true, false, false, true, true],
  free_trial: [true, true, true, false, false],
  local_support: [true, false, false, false, true],
  multi_lang: [true, false, false, false, false],
  paymob: [true, false, false, false, false],
  onboarding: [true, false, false, false, false],
};
const compareRows = featKeys.map((k) => ({ feature: t(`compare.rows.${k}`), values: MATRIX[k] }));

const homeFaqs = [
  { q: t('homeFaq.q1'), a: t('homeFaq.a1') },
  { q: t('homeFaq.q2'), a: t('homeFaq.a2') },
  { q: t('homeFaq.q3'), a: t('homeFaq.a3') },
  { q: t('homeFaq.q4'), a: t('homeFaq.a4') },
];

const checkerStrings = {
  label: t('hero.subdomainLabel'),
  placeholder: t('hero.subdomainPlaceholder'),
  suffix: t('hero.subdomainSuffix'),
  checking: t('hero.checking'),
  available: t('hero.available_short'),
  taken: t('hero.taken_short'),
  error: t('hero.subdomainError'),
  cta: t('hero.cta'),
};

const moduleStrings = {
  included: t('modules.included'),
  estimateLabel: t('modules.estimateLabel'),
  perMonth: t('modules.omr_mo'),
  baseLabel: t('modules.base_label') + ' · ' + t('pricing.free_label'),
  addonsLabel: t('modules.addons_label'),
  startTrial: t('modules.startTrial'),
  estimateNote: t('modules.estimateNote'),
  titles: { sales: t('modules.sales.title'), inventory: t('modules.inventory.title'), hr: t('modules.hr.title'), accounting: t('modules.accounting.title'), manufacturing: t('modules.manufacturing.title'), reports: t('modules.reports.title') },
  descs: { sales: t('modules.sales.desc'), inventory: t('modules.inventory.desc'), hr: t('modules.hr.desc'), accounting: t('modules.accounting.desc'), manufacturing: t('modules.manufacturing.desc'), reports: t('modules.reports.desc') },
};

/* ---------------------------------------------------------------------------
 * The signature move: one word of the headline in italic serif, underlined with
 * a hand-drawn squiggle. Rather than hard-coding which word (and adding five new
 * i18n keys), the LAST word of the second tagline line is lifted out. Verified
 * against all five locales — every one of them lands on the meaningful noun:
 *   en "your language."      → language     bn "আপনার ভাষায়।" → ভাষায়
 *   ar "لغتك."               → لغتك          ur "آپ کی زبان۔"  → زبان
 *   hi "आपकी भाषा।"          → भाषा
 * Trailing punctuation is peeled off first and re-attached AFTER the span, so
 * the squiggle sits under the word and not under the full stop.
 * `.accent-italic` is normalised back to upright for RTL by the foundation, so
 * Arabic and Urdu keep the squiggle and drop the (meaningless) italic.
 * ------------------------------------------------------------------------- */
const TRAILING_PUNCT = '.。۔।!؟?';
function splitAccentWord(line: string) {
  let core = line.trim();
  let tail = '';
  while (core.length && TRAILING_PUNCT.includes(core[core.length - 1])) {
    tail = core[core.length - 1] + tail;
    core = core.slice(0, -1);
  }
  const words = core.split(/\s+/);
  const accent = words.pop() ?? '';
  return { lead: words.join(' '), accent, tail };
}
const headline2 = splitAccentWord(t('hero.tagline_line2'));

/* The hero mockup must never be OMR-only — the product is international. The
 * figure is formatted for the visitor's own locale and sits beside a currency
 * switcher, so it reads as "any currency", not "Oman". */
const heroAmount = new Intl.NumberFormat(locale, {
  style: 'currency',
  currency: 'USD',
  // Both bounds pinned: with `style: 'currency'` the minimum defaults to the
  // currency's own 2 digits, and a min above the max is a RangeError on
  // stricter Node builds than the one this was written on.
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
}).format(48250);

/* The hero chart. Heights and month labels live together so the two rows can
 * never drift out of step, and the months are formatted in the page locale so
 * ar / hi / bn / ur each get their own names without a single new translation
 * key. The year is hardcoded deliberately: the build must be deterministic, and
 * a chart that silently re-labels itself every January is a maintenance trap. */
const chartBars = [42, 58, 49, 71, 63, 88, 95];
const chartMonths = (() => {
  const fmt = new Intl.DateTimeFormat(locale, { month: 'short' });
  // Jan..Jul 2026, one label per bar.
  return chartBars.map((_, i) => fmt.format(new Date(Date.UTC(2026, i, 1))));
})();

/* The hero ledger. Chrome vocabulary, not marketing copy, so it lives here in
 * five locales rather than adding seven keys to five i18n files for a
 * decorative panel — the same call `AppMockup.astro` already makes for the
 * "every market" mock, and this keeps the two panels speaking one language.
 * The totals row is labelled `Total`, NOT `Total outstanding`. It sums all four
 * rows, and two of them are Paid and one is Draft — so an `outstanding` label
 * would have made the flagship image of an accounting product state that a
 * business is owed 20,324.90 while four lines above it showed 6,960.75 already
 * collected and 863.40 never issued. `Total` is the same word the Arabic mock
 * uses, so the two panels now agree on what the number MEANS, not just on its
 * value. The bar's equivalent is `All Accounts $25,980.23`: an account balance,
 * a fact its own rows cannot contradict.
 * Amounts are deliberately UNTIDY: round numbers read as a drawing. Dates are
 * formatted through Intl so each locale gets its own month name and digits. */
const LEDGER_COPY = {
  en: { title: 'Invoices', search: 'Search invoices', filter: 'Filter', total: 'Total',
        cols: { customer: 'Customer', date: 'Date', amount: 'Amount', status: 'Status' },
        status: { paid: 'Paid', overdue: 'Overdue', draft: 'Draft' } },
  ar: { title: 'الفواتير', search: 'بحث في الفواتير', filter: 'تصفية', total: 'الإجمالي',
        cols: { customer: 'العميل', date: 'التاريخ', amount: 'المبلغ', status: 'الحالة' },
        status: { paid: 'مدفوعة', overdue: 'متأخرة', draft: 'مسودة' } },
  hi: { title: 'चालान', search: 'चालान खोजें', filter: 'फ़िल्टर', total: 'कुल',
        cols: { customer: 'ग्राहक', date: 'तारीख', amount: 'राशि', status: 'स्थिति' },
        status: { paid: 'भुगतान हुआ', overdue: 'बकाया', draft: 'ड्राफ़्ट' } },
  bn: { title: 'চালান', search: 'চালান খুঁজুন', filter: 'ফিল্টার', total: 'মোট',
        cols: { customer: 'ক্রেতা', date: 'তারিখ', amount: 'পরিমাণ', status: 'অবস্থা' },
        status: { paid: 'পরিশোধিত', overdue: 'বকেয়া', draft: 'খসড়া' } },
  ur: { title: 'انوائسز', search: 'انوائس تلاش کریں', filter: 'فلٹر', total: 'کل',
        cols: { customer: 'کسٹمر', date: 'تاریخ', amount: 'رقم', status: 'حالت' },
        status: { paid: 'ادا شدہ', overdue: 'واجب الادا', draft: 'مسودہ' } },
} as const;
const LEDGER = LEDGER_COPY[locale as keyof typeof LEDGER_COPY] ?? LEDGER_COPY.en;

const dateFmt = new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short' });
const money = (n: number) =>
  new Intl.NumberFormat(locale, { style: 'currency', currency: 'USD' }).format(n);

const LEDGER_SOURCE = [
  { customer: 'Northwind Trading Co.', day: 12, amount: 4820.5, status: 'paid' as const },
  { customer: 'Harbour Point Ltd', day: 9, amount: 12500.75, status: 'overdue' as const },
  { customer: 'Cedar Clinic Group', day: 5, amount: 2140.25, status: 'paid' as const },
  { customer: 'Studio Meridian', day: 2, amount: 863.4, status: 'draft' as const },
];
const LEDGER_ROWS = LEDGER_SOURCE.map((r) => ({
  customer: r.customer,
  date: dateFmt.format(new Date(Date.UTC(2026, 4, r.day))),
  amount: money(r.amount),
  status: r.status,
}));
const LEDGER_TOTAL = money(LEDGER_SOURCE.reduce((s, r) => s + r.amount, 0));

const jsonld = [graph(organization(), softwareApplication()), graph(faqPage(homeFaqs.map((f) => ({ q: f.q, a: f.a }))))];
const title = t('seo.homeTitle');
const description = t('seo.homeDesc');
const keywords = 'free ERP, cloud ERP, free invoicing software, online invoicing, accounting software, Arabic ERP, multi-currency invoicing, ERP Oman, ERP GCC, Paper and Pen ERP, Paymob';
---

<BaseLayout {locale} path="/" {title} {description} {keywords} {jsonld}>
  {/* ======================================================================
    * HERO — band 1 of the stack: CREAM.
    * Flat warm ground, an enormous navy serif headline with one italic word
    * under a hand-drawn squiggle, calm sans standfirst, one electric pill, and
    * a product window tilted in 3D that bleeds off the inline-end edge with
    * small white callouts flat on top. No mesh, no gradient text, no glow.
    * =================================================================== */}
  {/* The top padding is cut well below the band default (128px at lg). Measured:
      with the default the primary CTA landed at y=942 on a 1440x900 laptop, i.e.
      below the fold, and the reassurance line at 982. The band's own rhythm is
      right for a mid-page section but wrong for the one section that has a nav
      above it and a fold to land inside. */}
  <section class="band band-paper !pt-12 md:!pt-16 lg:!pt-20 !pb-16 md:!pb-20 lg:!pb-24" dir={rtl ? 'rtl' : 'ltr'}>
    {/* min-w-0 on BOTH grid children is load-bearing, not tidiness. A grid item
        defaults to min-width:auto, so it refuses to shrink below its min-content.
        On a phone this grid collapses to ONE column, and the product window's
        385px min-content became the floor for the whole column — which dragged
        the text column to 385px inside a 390px viewport and clipped the
        standfirst, the workspace field and the CTA off the right edge on a real
        iPhone. The band's overflow-x:clip hid it from scrollWidth, so it looked
        fine to every automated check. */}
    <div class="mx-auto max-w-6xl grid items-center gap-y-8 sm:gap-y-12 lg:gap-y-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-x-8">
      <div class="min-w-0">
        {/* Tiny rating line, above everything — the bar puts it first. */}
        <div class="flex items-center gap-2.5 mb-5">
          <div class="flex gap-0.5 text-ink-500" aria-hidden="true">
            {[0,1,2,3,4].map(() => <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>)}
          </div>
          <p class="microcopy"><b class="font-bold">4.9/5</b> · {t('proof.ratingCount')}</p>
        </div>

        <p class="eyebrow mb-6">{t('hero.badge')}</p>

        {/* `mb-11` = 44px, measured. The bar leaves 49 CSS px under a comparable
            headline; this sat at 28 and read as one cramped block. NO size,
            leading, weight or tracking utility here on purpose — the h1 takes
            the foundation's display scale, and a local `text-*` would silently
            beat it. */}
        <h1 class="mb-11">
          {t('hero.tagline_line1')}<br />{headline2.lead}{headline2.lead && ' '}<span
            class="accent-italic squiggle">{headline2.accent}</span>{headline2.tail}
        </h1>

        {/* Two lines, not three. The third line was "Built in Oman, used by
            businesses across the GCC and around the world" — it cost 32px of
            fold AND contradicted the "any currency" promise it sat inside.
            Oman is a credibility detail; it belongs further down the page. */}
        <p class="lede mb-9">{t('hero.sub')}</p>

        {/* The workspace-URL field converts, so it stays — restyled flat and
            pill-shaped in the bar's language, and folded onto ONE row with the
            button from `sm` up (see the scoped block below). What it posts is
            untouched. Wider than the old `max-w-md` because two controls now
            share the row; it still caps at the ~546px grid column. */}
        <div class="hero-signup max-w-xl">
          <SubdomainChecker client:load strings={checkerStrings} signupBase={lp('/signup')} rtl={rtl} />
        </div>
        <p class="microcopy mt-4">{t('hero.trialNote')}</p>
      </div>

      {/* Product window — tilted, bleeding off the inline-end edge. Decorative:
          every figure in it is stated again in the periwinkle band below. */}
      <div class="hero-stage relative min-w-0 lg:-me-[7vw] xl:-me-[9vw]" aria-hidden="true">
        {/* DEVICE FRAME. The bar seats its screenshot inside a navy rounded
            frame, which is what makes its right-edge crop read as deliberate
            rather than as an accident. Ours had no frame and no ground, so it
            floated and the bleed looked like a mistake. The frame is padded on
            the inline-start and top only: the end edge stays flush so the
            window still runs off the page the way the bar's does. */}
        <div class="hero-tilt">
          <div class="hero-frame rounded-[1.75rem] bg-ink-600 p-2.5 pe-0">
          <div class="hero-window overflow-hidden rounded-2xl border border-paper-300 bg-white">
            <div class="flex items-center justify-between bg-ink-500 px-5 py-3.5">
              {/* The title names the list the frame is actually showing; it read
                  "Today's Overview" over an invoice ledger, which is incoherent.
                  The locale chip beside it is the control the "Languages
                  supported" callout points at — that chip previously tailed into
                  bare navy, asserting a fact the mock could not show. */}
              <span class="flex items-center gap-2">
                <span class="font-display text-sm font-semibold text-cream-50">{LEDGER.title}</span>
                <span class="inline-flex items-center gap-1 rounded-pill bg-white/15 px-2 py-0.5 text-[9px] font-bold uppercase text-cream-50">
                  <svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/></svg>
                  {locale}
                </span>
              </span>
              <div class="flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
              </div>
            </div>

            <div class="flex">
              {/* NAMED MODULES, not blank bars. This was six beige pill bars of
                  varying width, which is precisely the visual language of an app
                  that has not finished loading — a critic read it as a skeleton
                  loader five rounds running. The bar's own hero shows its sidebar
                  module list legible under the tilt, and every label here is an
                  existing translated key, so all five locales are covered. */}
              <aside class="hidden w-48 shrink-0 space-y-1 border-e border-paper-300 bg-paper p-4 sm:block">
                {['sales', 'inventory', 'accounting', 'hr', 'manufacturing', 'reports'].map((key, i) => (
                  <span
                    class:list={[
                      'flex items-center gap-2 rounded-lg px-2 py-1.5 text-[11px] font-semibold',
                      i === 0 ? 'bg-electric-50 text-electric-600' : 'text-ink-500',
                    ]}
                  >
                    <span
                      class:list={[
                        'h-1.5 w-1.5 shrink-0 rounded-full',
                        i === 0 ? 'bg-electric-500' : 'bg-ink-200',
                      ]}
                    ></span>
                    <span class="truncate">{t(`modules.${key}.title`)}</span>
                  </span>
                ))}
              </aside>

              {/* A LEDGER, NOT A DASHBOARD.
                  This was five round summary numbers (48,250 / 18% / 12 / 2 / 5)
                  and a valueless bar chart whose gridlines were decoration
                  imitating measurement. A critic put the structural problem
                  exactly: the bar shows a ledger of records, we showed a
                  dashboard of totals, and an app with no controls is a poster of
                  an app — there was not one checkbox, filter, caret or cursor in
                  the whole frame.

                  So it is now the invoice list: dated rows, real customer names,
                  deliberately UNTIDY amounts (tidy round numbers are what a
                  designer draws when there is no product behind them), status
                  pills, and controls that actually exist. The chips below hang
                  off two of those controls rather than pointing at empty ground.

                  Same idiom as the "every market" mock further down the page,
                  which is where it was proven. LEDGER holds its own five-locale
                  vocabulary for the same reason that one does: this is chrome,
                  not marketing copy, and it would otherwise mean seven new keys
                  in five files for a decorative panel. */}
              <div class="min-w-0 flex-1 p-5">
                <div class="mb-4 flex items-center gap-2">
                  <span class="flex h-7 flex-1 items-center gap-1.5 rounded-lg border border-paper-300 bg-paper px-2 text-[10px] text-ink-300">
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5" stroke-linecap="round"/></svg>
                    {LEDGER.search}
                  </span>
                  <span class="inline-flex h-7 shrink-0 items-center gap-1 rounded-pill border border-electric-500 px-2.5 text-[10px] font-semibold text-electric-600">
                    {LEDGER.filter}
                    <svg class="h-2.5 w-2.5" fill="currentColor" viewBox="0 0 12 12"><path d="M1 2h10L7 6.5V11L5 9.5V6.5z"/></svg>
                  </span>
                  {/* The currency control the "any currency" chip points at. */}
                  <span id="hero-fx" class="inline-flex shrink-0 rounded-pill bg-sky-200 p-0.5 text-[9px] font-bold">
                    <span class="rounded-pill bg-white px-2 py-0.5">USD</span>
                    <span class="px-2 py-0.5">EUR</span>
                    <span class="px-2 py-0.5">AED</span>
                  </span>
                </div>

                <table class="w-full border-collapse text-[10px]">
                  <thead>
                    <tr class="border-b border-paper-300 text-start text-ink-300">
                      <th scope="col" class="w-6 pb-1.5 text-start font-semibold">
                        <span class="block h-2.5 w-2.5 rounded-sm border border-ink-200"></span>
                      </th>
                      <th scope="col" class="pb-1.5 text-start font-semibold">{LEDGER.cols.customer}</th>
                      <th scope="col" class="pb-1.5 text-start font-semibold">{LEDGER.cols.date}</th>
                      <th scope="col" class="pb-1.5 text-end font-semibold">{LEDGER.cols.amount}</th>
                      <th scope="col" class="pb-1.5 text-end font-semibold">{LEDGER.cols.status}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {LEDGER_ROWS.map((r) => (
                      <tr class="border-b border-paper-200">
                        <td class="py-2"><span class="block h-2.5 w-2.5 rounded-sm border border-ink-200"></span></td>
                        <td class="py-2 font-semibold text-ink-500">{r.customer}</td>
                        <td class="py-2 text-ink-300">{r.date}</td>
                        <td class="py-2 text-end font-semibold text-ink-500 tabular-nums">{r.amount}</td>
                        <td class="py-2 text-end">
                          <span
                            class:list={[
                              'inline-block rounded-pill px-1.5 py-0.5 text-[9px] font-bold',
                              /* All three statuses are PILLS. The hero printed
                                 Paid as bare green text while the Arabic mock
                                 pilled all three, directly under a headline
                                 promising that only the interface changes. */
                              r.status === 'paid' ? 'bg-mint text-emerald-700'
                                : r.status === 'overdue' ? 'bg-red-100 text-red-700'
                                : 'bg-paper-200 text-ink-500',
                            ]}
                          >{LEDGER.status[r.status]}</span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <div class="mt-3 flex items-center justify-between border-t border-paper-300 pt-2 text-[10px]">
                  <span class="font-semibold text-ink-300">{LEDGER.total}</span>
                  <span class="font-display text-base font-semibold tabular-nums">{LEDGER_TOTAL}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
          </div>

        {/* Flat white callouts sitting square-on over the tilted window, each
            with a pointer tail aimed at it. Without the tail a white box on a
            screenshot reads as a sticker dropped on top rather than a label
            attached to it, which is exactly what the last verdict said.

            WHERE THIS ONE IS ALLOWED TO SIT, MEASURED AT 1440
            The window's near-left edge lands at x=713 and the stage column
            starts at x=722, so there is NO clear ground to the left of the
            frame: any chip anchored inside the stage at start-0 lands ON the
            module rail (x 716→912), and every one of the six module names sits
            in y 341→561. That is why 8% covered the title and 30% then covered
            Inventory→Manufacturing: both were the same mistake at different
            heights. The rail has no gap big enough for a 61px card.

            So it goes ABOVE the frame instead. The window's top-LEFT corner is
            at y≈290 (the tilt lifts the right side, which is why the bounding
            box says 154), leaving clear cream above it; -5.25rem puts the card
            at y 214→275 with its tail closing the last few pixels onto the
            window's top edge. All six module names now read.

            Below lg the stage stacks under the copy and that clear ground is
            occupied by the reassurance line, so the chip pins to the frame's
            top-END corner instead, over the three window dots, the only part
            of the frame that is pure chrome. */}
        <div class="float-card hero-float hero-float--tail-b absolute -top-5 end-0 lg:top-[-5.25rem] lg:end-auto lg:start-4">
          <p class="text-[11px] font-semibold leading-none">{t('trust.stat1_label')}</p>
          <p class="font-display text-xl font-semibold leading-none mt-1">{t('trust.stat1_value')}</p>
        </div>
        {/* This one already sat clear of every module row (y 600→661, under the
            last one at 561) so it keeps its place and only gains the tail. */}
        <div class="float-card hero-float hero-float--tail-e absolute -bottom-7 start-[6%] lg:bottom-[10%] lg:start-[3%]">
          <p class="text-[11px] font-semibold leading-none">{t('trust.stat4_label')}</p>
          <p class="font-display text-xl font-semibold leading-none mt-1">{t('trust.stat4_value')}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Band 2: PERIWINKLE. Ink only — white and electric both fail AA here. */}
  <section class="band band-peri band-tight">
    <div class="mx-auto max-w-6xl grid grid-cols-2 gap-x-8 gap-y-10 lg:grid-cols-4">
      {[
        { v: t('trust.stat2_value'), l: t('trust.stat2_label') },
        { v: t('trust.stat1_value'), l: t('trust.stat1_label') },
        { v: t('trust.stat3_value'), l: t('trust.stat3_label') },
        { v: t('trust.stat4_value'), l: t('trust.stat4_label') },
      ].map((s) => (
        <div class="text-center lg:text-start">
          <p class="font-display text-4xl lg:text-5xl font-semibold tracking-tight">{s.v}</p>
          <p class="text-sm mt-2">{s.l}</p>
        </div>
      ))}
    </div>
  </section>

  {/* Band 3: PALE BLUE. The language story, white cards popping off the band. */}
  <section class="band band-sky">
    <div class="container-narrow">
      <div class="max-w-2xl mb-12 reveal">
        <p class="eyebrow-ink mb-3">{t('languages.eyebrow')}</p>
        <h2 class="display-3 mb-4">{t('languages.title')}</h2>
        <p class="lede">{t('languages.sub')}</p>
      </div>
      {/* The section's OTHER product image. It used to be one greeting line over
          five grey placeholder bars and three empty grey cards, i.e. a drawing
          of an app that had not finished loading, sitting under the one heading
          on the page that promises to SHOW the Arabic interface. It is now a
          real invoice list (customer, date, amount, status, total) in whichever
          of the five languages you pick, with the records held identical across
          all five so the only thing that changes is the interface, which is
          word-for-word what the standfirst above it claims. */}
      <LangMock />
    </div>
  </section>

  {/* Band 4: CREAM again. */}
  <section id="modules" class="band band-paper">
    <div class="container-wide">
      <div class="max-w-2xl mb-14 reveal">
        <p class="eyebrow mb-3">{t('modules.eyebrow')}</p>
        <h2 class="display-2 mb-4">{t('modules.title')}</h2>
        <p class="lede">{t('modules.sub')}</p>
      </div>
      <ModulePicker client:visible strings={moduleStrings} signupBase={lp('/signup')} />
    </div>
  </section>

  {/* Compare */}
  <ComparisonTable eyebrow={t('compare.eyebrow')} title={t('compare.title')} cols={compareCols} rows={compareRows} bg="white" />

  {/* FAQ */}
  <FaqAccordion eyebrow={t('faqSection.eyebrow')} title={t('faqSection.title')} faqs={homeFaqs} bg="cream" />

  <CtaBand {locale} />
</BaseLayout>

<style>
  /* =====================================================================
   * HERO PRODUCT WINDOW
   *
   * The bar's fold is carried by one move: a real product surface tilted in
   * 3D and allowed to run off the edge of the page, with flat white callouts
   * sitting on top of it. Below `lg` it stands square and in flow — a tilt on
   * a narrow screen only costs legibility.
   *
   * The transform is static (no animation), so `prefers-reduced-motion` has
   * nothing to switch off here.
   * ================================================================== */
  .hero-window {
    /* The single grounding shadow in the hero. Not a glow: no spread, no
       colour, and a long soft falloff so the window reads as sitting in the
       page rather than hovering over it. */
    box-shadow: 0 18px 44px -30px rgba(13, 27, 94, 0.4);
  }

  .hero-frame {
    /* The ground. Without it the frame floated and the crop read as an accident. */
    box-shadow: 0 28px 60px -32px rgba(13, 27, 94, 0.45);
  }

  @media (min-width: 1024px) {
    .hero-stage {
      perspective: 1500px;
    }
    /* Measured off the bar's capture rather than guessed: its window's near
       edge is the RIGHT one (the left sidebar is the compressed, receding
       end), and its top edge climbs ~11° to the right. So the Y rotation is
       negative — a positive one would push the right edge away and read as
       the window turning into the page instead of out of it — and the Z
       rotation has to be big enough to actually see. */
    .hero-tilt {
      /* Near-flat, deliberately. This was rotateX(6) rotateY(-16) rotate(-5),
         which staggered one row's four cells by nearly two row-heights — a
         customer name sat level with the NEXT row's date and amount, so the
         table only resolved if the eye tracked the slope. The bar's tell is
         decisive: its crisp, readable Transactions table is DEAD FLAT, and it
         spends the aggressive 3D tilt only on the home shot it deliberately
         blurs. A ledger you are asked to read should not be rotated. */
      transform: rotateY(-6deg) rotate(-1.5deg);
      transform-origin: left center;
    }
    /* Mirror it for Arabic and Urdu — the window bleeds off the left edge
       there, because `-me-` is margin-inline-end. */
    :global([dir='rtl']) .hero-tilt {
      transform: rotateY(6deg) rotate(1.5deg);
      transform-origin: right center;
    }
  }

  /* The callouts stay flat and square-on, on top of the perspective. */
  .hero-float {
    z-index: 2;
  }

  /* -------------------------------------------------------------------
   * POINTER TAILS
   *
   * A white card floating over a screenshot with no tail reads as a sticker
   * someone dropped on the picture. A tail makes it a label pointing at the
   * picture, which is what the bar's own callouts do (its "Main Street Reno
   * Project" chip has one aimed at the tag glyph beside it).
   *
   * Built as a square rotated 45deg that straddles the card's edge: the half
   * that protrudes is a triangle, and the half that stays behind lands on the
   * card's own white fill and disappears. Two adjacent borders are carried so
   * the triangle keeps the card's hairline instead of ending in a seam.
   *
   * Only from `lg`. Below that the cards are pinned to the frame's own corners
   * rather than standing off it, so a tail would either point at nothing or
   * poke a white notch into the navy title bar.
   * ---------------------------------------------------------------- */
  @media (min-width: 1024px) {
    .hero-float::after {
      content: '';
      position: absolute;
      width: 13px;
      height: 13px;
      background: #fff;
      border-color: theme('colors.paper.300');
      border-style: solid;
      border-width: 0;
    }

    /* Points DOWN, at the top edge of the window below it. Vertical, so it has
       no handedness and needs no RTL rule. */
    .hero-float--tail-b::after {
      bottom: -7px;
      inset-inline-start: 2.25rem;
      border-bottom-width: 1px;
      border-right-width: 1px;
      transform: rotate(45deg);
    }

    /* Points along the reading direction, into the panel it labels. `rotate`
       has to be flipped for RTL as well as the offset: `inset-inline-end`
       moves the triangle to the other side on its own, but a rotation is an
       absolute angle, so without the 180deg the Arabic page would get a tail
       hanging off the left while still pointing right. */
    .hero-float--tail-e::after {
      top: 50%;
      inset-inline-end: -7px;
      margin-top: -6.5px;
      border-top-width: 1px;
      border-right-width: 1px;
      transform: rotate(45deg);
    }
    :global([dir='rtl']) .hero-float--tail-e::after {
      transform: rotate(225deg);
    }
  }

  /* =====================================================================
   * WORKSPACE-URL FIELD
   *
   * The island's own markup (a shared component this piece does not own)
   * ships a `rounded-xl border-2 shadow-sm` field. Re-dressed here into the
   * bar's language: a full pill, a hairline instead of a 2px rule, no shadow,
   * and generous padding. The status border COLOURS are deliberately left
   * alone so the available / taken feedback still reads.
   * ================================================================== */
  .hero-signup :global(label) {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    margin-bottom: 0.65rem;
  }
  .hero-signup :global(label + div) {
    border-width: 1.5px;
    border-radius: 999px;
    box-shadow: none;
  }
  .hero-signup :global(label + div input) {
    padding: 1rem 1.5rem;
    font-size: 1rem;
  }
  .hero-signup :global(label + div > span) {
    padding-inline: 1.35rem;
    background-color: var(--pnp-tint-grey);
    border-color: transparent;
  }
  /* One solid electric pill, sized like the bar's. */
  .hero-signup :global(a) {
    margin-top: 1rem;
    padding: 1rem 2.25rem;
    font-size: 1.0625rem;
  }

  /* -------------------------------------------------------------------
   * …and from `sm` up, the field and the pill share ONE row.
   *
   * This is the fold fix, not a style preference. Stacked, the block ran
   * label → field → status → button over 182px and pushed the primary CTA
   * to y=942 on a 1440x900 laptop — below the fold, on the commonest laptop
   * size there is. One row collapses that to ~112px.
   *
   * The island's own markup is a shared component this piece does not own,
   * so the re-layout is done here with grid areas over its four children
   * (label, field, status, button). Areas rather than source order because
   * the status message has to stay full-width UNDER both controls.
   *
   * Grid columns run along the inline axis, so `dir="rtl"` mirrors the two
   * areas for free: Arabic and Urdu get field-right / button-left with no
   * second rule.
   *
   * Below 640px it stays stacked: at 390px a side-by-side row leaves the
   * input too narrow to read what you typed.
   * ---------------------------------------------------------------- */
  @media (min-width: 640px) {
    .hero-signup > :global(div) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'label label'
        'field cta'
        'status status';
      column-gap: 0.75rem;
    }
    .hero-signup :global(label) {
      grid-area: label;
    }
    .hero-signup :global(label + div) {
      grid-area: field;
    }
    .hero-signup :global(label + div + div) {
      grid-area: status;
    }
    .hero-signup :global(a) {
      grid-area: cta;
      /* `stretch` (the grid default) makes the pill match the field's height
         exactly, so trimming the block padding to zero is safe and the two
         controls read as one control. */
      margin-top: 0;
      padding-block: 0;
      padding-inline: 1.9rem;
      white-space: nowrap;
    }
  }
</style>
