---
import CollectionIndex from '@/components/templates/CollectionIndex.astro';
import { getCollection } from 'astro:content';
import { localeStaticPaths, hubEntries } from '@/lib/paths';
import { useTranslations, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const all = await getCollection('usecases');
const list = hubEntries(all, locale)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title))
  .map((e) => ({ slug: e.data.slug, title: e.data.title, heroSubtitle: e.data.heroSubtitle, icon: e.data.features?.[0]?.icon }));
---
<CollectionIndex
  {locale}
  basePath="/use-cases"
  title={t('useCasesIndex.title')}
  eyebrow={t('useCasesIndex.eyebrow')}
  sub={t('useCasesIndex.sub')}
  metaTitle={t('useCasesIndex.metaTitle')}
  metaDescription={t('useCasesIndex.metaDesc')}
  items={list}
  onward={[
    { href: '/features', label: t('featuresIndex.title') },
    { href: '/free-invoicing-software', label: t('fi.crumb') },
    { href: '/pricing', label: t('nav.pricing') },
  ]}
/>
