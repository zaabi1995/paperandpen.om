---
import CollectionIndex from '@/components/templates/CollectionIndex.astro';
import { getCollection } from 'astro:content';
import { localeStaticPaths } from '@/lib/paths';
import { useTranslations, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const all = await getCollection('industries');
const mine = all.filter((entry) => entry.data.locale === locale);
const list = (mine.length ? mine : all.filter((entry) => entry.data.locale === 'en'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((entry) => ({
    slug: entry.data.slug,
    title: entry.data.title,
    heroSubtitle: entry.data.heroSubtitle,
    icon: entry.data.features?.[0]?.icon,
  }));
---
<CollectionIndex
  {locale}
  basePath="/industries"
  title={t('industriesIndex.title')}
  eyebrow={t('industriesIndex.eyebrow')}
  sub={t('industriesIndex.sub')}
  metaTitle={t('seo.industriesTitle')}
  metaDescription={t('seo.industriesDesc')}
  items={list}
  onward={[
    { href: '/use-cases/small-business', label: t('nav.solutions') },
    { href: '/free-invoicing-software', label: t('mega.allFeatures') },
    { href: '/pricing', label: t('nav.pricing') },
  ]}
/>
