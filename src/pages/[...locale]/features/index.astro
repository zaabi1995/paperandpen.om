---
import CollectionIndex from '@/components/templates/CollectionIndex.astro';
import { getCollection } from 'astro:content';
import { localeStaticPaths } from '@/lib/paths';
import { useTranslations, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const all = await getCollection('features');
const mine = all.filter((e) => e.data.locale === locale);
const list = (mine.length ? mine : all.filter((e) => e.data.locale === 'en'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title))
  .map((e) => ({ slug: e.data.slug, title: e.data.title, heroSubtitle: e.data.heroSubtitle, icon: e.data.features?.[0]?.icon }));
---
<CollectionIndex
  {locale}
  basePath="/features"
  title={t('featuresIndex.title')}
  eyebrow={t('featuresIndex.eyebrow')}
  sub={t('featuresIndex.sub')}
  metaTitle={t('featuresIndex.metaTitle')}
  metaDescription={t('featuresIndex.metaDesc')}
  items={list}
  onward={[
    { href: '/free-invoicing-software', label: t('fi.crumb') },
    { href: '/invoicing', label: t('invoicingIndex.title') },
    { href: '/pricing', label: t('nav.pricing') },
  ]}
/>
