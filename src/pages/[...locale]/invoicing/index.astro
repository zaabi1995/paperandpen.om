---
import CollectionIndex from '@/components/templates/CollectionIndex.astro';
import { getCollection } from 'astro:content';
import { localeStaticPaths, hubEntries } from '@/lib/paths';
import { useTranslations, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const all = await getCollection('documents');
const list = hubEntries(all, locale)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title))
  .map((e) => ({ slug: e.data.slug, title: e.data.title, heroSubtitle: e.data.heroSubtitle, icon: e.data.features?.[0]?.icon }));
---
<CollectionIndex
  {locale}
  basePath="/invoicing"
  title={t('invoicingIndex.title')}
  eyebrow={t('invoicingIndex.eyebrow')}
  sub={t('invoicingIndex.sub')}
  metaTitle={t('invoicingIndex.metaTitle')}
  metaDescription={t('invoicingIndex.metaDesc')}
  items={list}
  onward={[
    { href: '/features/invoicing', label: t('mega.invoicing') },
    { href: '/free-invoicing-software', label: t('fi.crumb') },
    { href: '/invoice-templates', label: t('nav.templates') },
    { href: '/tools/free-invoice-generator', label: t('mega.invoiceGen') },
  ]}
/>
