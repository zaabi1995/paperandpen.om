---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LoginForm from '@/components/islands/LoginForm.tsx';
import { useTranslations, localizePath, type Locale } from '@/i18n';
import { localeStaticPaths } from '@/lib/paths';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
---
<!-- Same shell as /signup/: one continuous cream ground, transparent chrome. -->
<BaseLayout
  {locale}
  bare
  path="/login"
  noindex
  title={t('seo.loginTitle')}
  description={t('seo.loginDesc')}
>
  <div class="flex min-h-screen flex-col bg-paper">
    <header class="px-6 pb-4 pt-6 sm:px-10 sm:pt-8">
      <div class="mx-auto flex max-w-md items-center justify-between gap-4">
        <a href={lp('/')} class="inline-flex items-center">
          <img src="/logo.svg" alt="Paper & Pen ERP" class="h-8 w-auto" width="120" height="32" />
        </a>
        <a
          href={lp('/signup')}
          class="text-sm font-semibold text-electric-500 underline-offset-4 hover:text-electric-600 hover:underline"
        >
          {t('nav.startFree')}
        </a>
      </div>
    </header>

    <!-- Top-aligned for the same reason as /signup/: a centred block leaves
         near-equal cream above and below it and reads as adrift. The column is
         also the same 28rem reading measure the signup step uses, so the two
         auth pages are one control width, not two. -->
    <div class="flex flex-1 justify-center px-6 pb-12 pt-6 sm:px-10 sm:pt-10">
      <div class="w-full max-w-md">
        <LoginForm client:load {locale} />
      </div>
    </div>

    <footer class="px-6 pb-8 sm:px-10">
      <p class="mx-auto max-w-md text-sm font-medium text-ink-500">{t('signup.securedBy')}</p>
    </footer>
  </div>
</BaseLayout>
