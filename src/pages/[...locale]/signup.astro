            <polygon class="fill-paper opacity-15" points="38.44 95.23 127.74 68.9 0 0" />
            <path class="fill-paper" d="M9.87,124.45s22.65,13.94,51.1.58c0,0,33.1,11.03,57.49-.58v17.5c0,5.05-2.44,9.79-6.56,12.71l-49.77,35.4-46.35-36.53c-3.76-2.97-5.95-7.5-5.94-12.29l.03-16.8Z" />
            <path d="M90.61,169.81c-21.75-9.53-42.11-4.94-54.37-.14l25.88,20.4,28.48-20.26Z" />
          </svg>
          <svg
            class="h-8 w-auto"
            viewBox="135.5 70 120.5 88"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M157.7,84.12c0,4.2-.85,7.33-2.55,9.39-1.7,2.06-4.46,3.09-8.28,3.09h-3.67v14.61h-6.99v-39.52h10.65c3.89,0,6.67,1.03,8.33,3.09,1.66,2.06,2.49,5.17,2.49,9.34ZM150.65,84.12c0-2.1-.3-3.65-.89-4.64-.59-.99-1.63-1.49-3.12-1.49h-3.44v12.26h3.44c1.49,0,2.53-.5,3.12-1.49s.89-2.54.89-4.64Z" />
            <path d="M165.66,103.53l-1.6,7.68h-7.33l10.14-39.52h6.87l10.08,39.52h-7.33l-1.6-7.68h-9.22ZM170.3,81.19l-3.32,16.04h6.65l-3.32-16.04Z" />
            <path d="M208.05,84.12c0,4.2-.85,7.33-2.55,9.39-1.7,2.06-4.46,3.09-8.28,3.09h-3.67v14.61h-6.99v-39.52h10.65c3.89,0,6.67,1.03,8.33,3.09,1.66,2.06,2.49,5.17,2.49,9.34ZM201,84.12c0-2.1-.3-3.65-.89-4.64-.59-.99-1.63-1.49-3.12-1.49h-3.44v12.26h3.44c1.49,0,2.53-.5,3.12-1.49s.89-2.54.89-4.64Z" />
            <path d="M218.42,87.95h9.17v6.3h-9.17v10.65h10.65v6.3h-17.64v-39.52h17.64v6.36h-10.65v9.91Z" />
            <path d="M239.96,95.34v15.87h-7.04v-39.52h10.77c3.9,0,6.65.94,8.28,2.81,1.62,1.87,2.43,4.87,2.43,8.99,0,2.63-.36,4.83-1.09,6.59s-1.91,3.07-3.55,3.95l5.9,17.18h-7.33l-4.98-15.87h-3.38ZM243.62,89.04c1.41,0,2.39-.47,2.92-1.4.53-.94.8-2.32.8-4.15s-.26-3.21-.77-4.12c-.52-.92-1.5-1.37-2.95-1.37h-3.67v11.05h3.67Z" />
            <path d="M160.33,151.22h.69v5.79h-2.75c-1.26,0-2.22-.23-2.89-.69-.67-.46-1.4-1.32-2.21-2.58-1.07,1.38-2.27,2.36-3.61,2.95-1.34.59-2.88.89-4.64.89-2.67,0-4.83-.84-6.47-2.52-1.64-1.68-2.46-3.91-2.46-6.7,0-1.99.49-3.94,1.46-5.87s2.61-4.12,4.9-6.56c-1.49-2.44-2.55-4.4-3.18-5.87-.63-1.47-.94-2.95-.94-4.44,0-2.6.82-4.7,2.46-6.3,1.64-1.6,3.78-2.41,6.42-2.41s4.72.8,6.36,2.41c1.64,1.6,2.46,3.71,2.46,6.3,0,1.68-.44,3.4-1.32,5.16-.88,1.76-2.35,3.74-4.41,5.96l3.49,5.84,2.63-4.24,4.75,3.27-4.12,6.42,1.03,1.72c.31.53.64.92,1,1.15.36.23.81.34,1.35.34ZM150.02,148.53l-4.41-7.22c-1.11,1.26-1.88,2.38-2.32,3.35-.44.97-.66,1.98-.66,3.01,0,1.22.28,2.16.83,2.81.55.65,1.31.97,2.26.97.76,0,1.47-.21,2.12-.63.65-.42,1.38-1.18,2.18-2.29ZM144.58,125.28c0,.69.16,1.48.49,2.38s.93,2.09,1.8,3.58c1.07-1.22,1.79-2.26,2.15-3.12.36-.86.54-1.8.54-2.83s-.22-1.81-.66-2.35c-.44-.54-1.04-.8-1.8-.8-.8,0-1.42.28-1.86.83s-.66,1.33-.66,2.32Z" />
            <path d="M202.89,129.92c0,4.2-.85,7.33-2.55,9.39-1.7,2.06-4.46,3.09-8.28,3.09h-3.67v14.61h-6.99v-39.52h10.65c3.89,0,6.67,1.03,8.33,3.09,1.66,2.06,2.49,5.17,2.49,9.34ZM195.85,129.92c0-2.1-.3-3.65-.89-4.64-.59-.99-1.63-1.49-3.12-1.49h-3.44v12.26h3.44c1.49,0,2.53-.5,3.12-1.49s.89-2.54.89-4.64Z" />
            <path d="M216.13,133.75h9.17v6.3h-9.17v10.65h10.65v6.3h-17.64v-39.52h17.64v6.36h-10.65v9.91Z" />
            <path d="M255.82,157.01h-7.05l-8.25-21.08v21.08h-7.04v-39.52h7.04l8.25,22v-22h7.05v39.52Z" />
          </svg>
        </a>
        <a
          href={lp('/login')}
          class="inline-flex min-h-6 items-center text-sm font-semibold text-electric-500 underline-offset-4 hover:text-electric-600 hover:underline"
        >
          {t('nav.login')}
        </a>
      </div>
    </header>

    <!-- CENTRED ON THE VERTICAL AXIS, and this is a reversal — read why before
         flipping it back a third time.
         Round 2 centred it, round 3 top-anchored it, and both lost. Measured at
         1440x900 the top-anchored version put every pixel of content in rows
         120-541 of a 768px band, so 307px of unassigned cream sat under the CTA
         and the "Secured by Paymob" line looked stranded rather than placed.
         The bar never leaves a fold like that: wave-payroll optically centres
         its text column against a right-hand column that spans the whole band.
         So the answer was never "top or centre" on its own — it is centre PLUS
         a right column with enough mass to define the band (see the rail in
         SignupForm). Centring alone is what read adrift in round 2.
         `my-auto` on the child rather than `items-center` on the parent: auto
         margins resolve to 0 when there is no free space, so the tall step 3
         and every phone viewport flow from the top and nothing is ever clipped
         off the top edge the way flex centring famously does.
         `flex-1` still pushes the footer to the bottom on a short step. -->
    <div class="flex flex-1 justify-center px-6 pb-12 pt-6 sm:px-10 sm:pt-10">
      <div class="my-auto w-full max-w-md lg:max-w-[51rem]">
        <SignupForm client:load {locale} />
      </div>
    </div>

    <footer class="px-6 pb-8 sm:px-10">
      <p class="mx-auto max-w-md text-sm font-medium text-ink-500 lg:max-w-[51rem]">
        {t('signup.securedBy')}
      </p>
    </footer>
  </div>
</BaseLayout>
