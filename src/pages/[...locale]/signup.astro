---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SignupForm from '@/components/islands/SignupForm.tsx';
import { useTranslations, localizePath, type Locale } from '@/i18n';
import { localeStaticPaths } from '@/lib/paths';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
---
<!--
  ONE GROUND. The old shell put the form in a white box under a white,
  hairline-bordered header bar sitting on cream — three surfaces stacked before
  a single field appeared. The bar never does that: its page is one continuous
  warm off-white, and the only panels on it are flat tinted fills. So the header
  and footer here are transparent, and the sole card is the rail inside the form.
-->
<BaseLayout
  {locale}
  bare
  path="/signup"
  noindex
  title={t('seo.signupTitle')}
  description={t('seo.signupDesc')}
>
  <div class="flex min-h-screen flex-col bg-paper">
    <header class="px-6 pb-4 pt-6 sm:px-10 sm:pt-8">
      <!-- 51rem is not a round number, it is the exact sum of the two grid
           tracks and the gap between them (28 + 4 + 19). max-w-4xl was 896px,
           so the 816px grid floated with 40px of slack on each side and the
           logo no longer sat over the left edge of the field. Sized to the
           content, header, form and footer all share one margin. Below `lg`
           the shell collapses to the single 28rem measure so a lone field can
           never stretch into a trough on a tablet. -->
      <div class="mx-auto flex max-w-md items-center justify-between gap-4 lg:max-w-[51rem]">
        <!--
          THE MARK, IN THE PAGE'S OWN INK.

          This was `<img src="/logo.svg" class="h-8">`. That file is the full
          four-colour lockup on a 255x201 canvas, so at 32px tall the "PAPER &
          PEN" letters rendered about 6px high: a soft blue smudge, and in
          rgb(60,123,190), a fourth blue belonging to neither the headline navy
          nor the electric CTA. It read as a pasted asset next to a 60px serif.

          Same artwork, inlined and set in one ink. Nothing is redrawn: the shield
          and the real wordmark are the logo's own vector paths, recoloured to
          `currentColor` (ink-500, the exact navy of the h1 below) and sized so
          the letterforms are actually legible. The `Company` line is dropped
          rather than shipped at 4px. The crease and the paper band are knocked
          out in the page ground instead of a second blue, so the mark carries
          no colour the design system has not already spent.

          `aria-label` on the link is the accessible name; both drawings are
          decorative to a screen reader.
        -->
        <a
          href={lp('/')}
          aria-label="Paper &amp; Pen"
          dir="ltr"
          class="inline-flex items-center gap-2.5 text-ink-500"
        >
          <svg
            class="h-9 w-auto"
            viewBox="0 0 127.74 201.68"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
