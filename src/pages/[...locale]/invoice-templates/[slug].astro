---
import { getCollection } from 'astro:content';
import MarketingPage from '@/components/templates/MarketingPage.astro';
import { contentStaticPaths } from '@/lib/paths';
import { useTranslations, type Locale } from '@/i18n';

export async function getStaticPaths() {
  return contentStaticPaths(await getCollection('templates'));
}
const { data, locale } = Astro.props as { data: any; locale: Locale };
const t = useTranslations(locale);
---
<MarketingPage {locale} {data} basePath="/invoice-templates" section={{ label: t('nav.templates'), href: '/invoice-templates' }} />
