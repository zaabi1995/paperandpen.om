---
import { getCollection } from 'astro:content';
import EinvoicingGuidePage from '@/components/templates/EinvoicingGuidePage.astro';
import { contentStaticPaths } from '@/lib/paths';
import type { Locale } from '@/i18n';

export async function getStaticPaths() {
  return contentStaticPaths(await getCollection('einvoicing'));
}
const { data, locale } = Astro.props as { data: any; locale: Locale };
---
<EinvoicingGuidePage {locale} {data} />
