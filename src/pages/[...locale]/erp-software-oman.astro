      ['/contact', 'تواصل مع Paper & Pen', 'اسأل عن التطبيق أو نقل البيانات أو ملاءمة المنتج.'],
    ],
    schemaFeatures: 'المبيعات والفوترة؛ إدارة المخزون؛ المحاسبة ومسك الدفاتر؛ الموارد البشرية والرواتب؛ التصنيع؛ التقارير والتحليلات؛ واجهة عربية من اليمين إلى اليسار؛ فوترة متعددة العملات',
  },
} as const;

const c = COPY[locale === 'ar' ? 'ar' : 'en'];
const faqs = c.faqs.map(([q, a]) => ({ q, a }));
const pagePath = '/erp-software-oman';
const pageUrl = `https://paperandpen.om${lp(pagePath)}`;
const crumbs = [
  { name: locale === 'ar' ? 'الرئيسية' : 'Home', url: '/' },
  { name: c.crumb, url: pagePath },
];
const appNode = softwareApplication({
  description: c.description,
  url: pageUrl,
  inLanguage: locale,
  featureList: c.schemaFeatures,
  publisher: { '@id': 'https://paperandpen.om/#organization' },
  provider: { '@id': 'https://paperandpen.om/#organization' },
  isAccessibleForFree: true,
  mainEntityOfPage: pageUrl,
});
const jsonld = [graph(appNode, faqPage(faqs), breadcrumbList(crumbs, locale))];
---

<BaseLayout
  {locale}
  path={pagePath}
  title={c.title}
  description={c.description}
  keywords={c.keywords}
  alternateLocales={['en', 'ar']}
  {jsonld}
>
  <Breadcrumbs {locale} crumbs={[{ name: locale === 'ar' ? 'الرئيسية' : 'Home', href: '/' }, { name: c.crumb }]} />
  <PageHero
    {locale}
    eyebrow={c.eyebrow}
    title={c.h1}
    subtitle={c.lede}
    primaryCta={{ href: '/signup', label: c.primaryCta }}
    secondaryCta={{ href: '/pricing', label: c.secondaryCta }}
  />

  <section class="band band-tint band-tight">
    <div class="container-wide grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16">
      <div>
        <h2 class="font-display text-display-sm text-ink-500">{c.answerTitle}</h2>
        <p data-search-answer class="mt-5 text-lg leading-relaxed text-ink-500">{c.description}</p>
        <p class="mt-5 text-base leading-relaxed text-ink-500">{c.answer}</p>
      </div>
      <dl class="grid gap-10 sm:grid-cols-2">
        {c.facts.map(([term, detail]) => (
          <div class="border-t border-ink-200 pt-4">
            <dt class="text-sm font-bold uppercase tracking-[0.12em] text-ink-500">{term}</dt>
            <dd class="mt-2 text-base leading-relaxed text-ink-500">{detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band band-surface">
    <div class="container-narrow">
      <p class="eyebrow mb-4">{c.definitionEyebrow}</p>
      <h2 class="font-display text-display-sm text-ink-500">{c.definitionTitle}</h2>
      <p class="lede mt-6">{c.definitionBody}</p>
      <h3 class="mt-10 font-display text-2xl text-ink-500">{c.fitTitle}</h3>
      <ul class="mt-6 space-y-4">
        {c.fitItems.map((item) => (
          <li class="flex items-start gap-3.5 text-base leading-relaxed text-ink-500">
            <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-violet-600 text-white" aria-hidden="true">
              <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band-paper">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">{c.modulesEyebrow}</p>
        <h2 class="font-display text-display-sm text-ink-500">{c.modulesTitle}</h2>
        <p class="lede mt-6">{c.modulesIntro}</p>
      </div>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {c.modules.map(([href, title, body]) => (
          <article class="border-t border-ink-200 pt-6">
            <h3 class="font-display text-2xl text-ink-500"><a href={lp(href)} class="no-underline hover:text-electric-500 hover:underline">{title}</a></h3>
            <p class="mt-3 text-base leading-relaxed text-ink-500">{body}</p>
            <a href={lp(href)} class="mt-5 inline-flex text-sm font-bold text-ink-500 underline decoration-2 underline-offset-4 hover:text-electric-500">{title}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-sky">
    <div class="container-narrow">
      <p class="eyebrow-ink mb-4">{c.workflowEyebrow}</p>
      <h2 class="font-display text-display-sm text-ink-500">{c.workflowTitle}</h2>
      <ol class="mt-10 space-y-6">
        {c.workflow.map(([title, body], index) => (
          <li class="flex gap-4 border-t border-ink-300 pt-6">
            <span class="shrink-0 font-display text-3xl text-ink-500" aria-hidden="true">{index + 1}</span>
            <div class="min-w-0">
              <h3 class="font-display text-xl text-ink-500">{title}</h3>
              <p class="mt-2 text-base leading-relaxed text-ink-500">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band-peri">
    <div class="container-wide grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-20">
      <div>
        <p class="eyebrow-ink mb-4">{c.truthEyebrow}</p>
        <h2 class="font-display text-display-sm text-ink-500">{c.truthTitle}</h2>
        <p class="lede mt-6 text-ink-500">{c.truthBody}</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-start text-ink-500">
          <caption class="mb-5 text-start font-display text-2xl font-semibold text-ink-500">{c.decisionTitle}</caption>
          <tbody>
            {c.decisionRows.map(([criterion, check]) => (
              <tr class="border-t border-ink-500">
                <th scope="row" class="py-4 pe-6 text-start align-top text-sm font-bold">{criterion}</th>
                <td class="py-4 text-base leading-relaxed">{check}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band band-tint band-tight">
    <div class="container-narrow">
      <p class="eyebrow mb-4">{c.distinctionEyebrow}</p>
      <h2 class="font-display text-display-sm text-ink-500">{c.distinctionTitle}</h2>
      <p class="lede mt-6">{c.distinctionBody}</p>
      <a href={lp('/stationery-supplies-oman')} class="mt-7 inline-flex font-bold text-ink-500 underline decoration-2 underline-offset-4 hover:text-electric-600">{c.distinctionLink}</a>
    </div>
  </section>

  <FaqAccordion title={c.faqTitle} eyebrow={c.faqEyebrow} faqs={faqs} bg="white" />
  <RelatedLinks {locale} title={c.relatedTitle} links={c.related.map(([href, title, desc]) => ({ href, title, desc }))} />
  <CtaBand {locale} />
</BaseLayout>
