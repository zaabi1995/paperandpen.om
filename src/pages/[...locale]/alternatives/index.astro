---
import CollectionIndex from '@/components/templates/CollectionIndex.astro';
import { getCollection } from 'astro:content';
import { localeStaticPaths } from '@/lib/paths';
import { useTranslations, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const all = await getCollection('alternatives');
const mine = all.filter((e) => e.data.locale === locale);
const list = (mine.length ? mine : all.filter((e) => e.data.locale === 'en'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((e) => ({ slug: e.data.slug, title: e.data.title, heroSubtitle: e.data.heroSubtitle, icon: e.data.features?.[0]?.icon }));
---
<CollectionIndex
  {locale}
  basePath="/alternatives"
  title={t('altIndex.title')}
  eyebrow={t('altIndex.eyebrow')}
  sub={t('altIndex.sub')}
  metaTitle={t('seo.altTitle')}
  metaDescription={t('seo.altDesc')}
  items={list}
  onward={[
    { href: '/compare/paperandpen-vs-zoho', label: t('nav.compare') },
    { href: '/pricing', label: t('nav.pricing') },
    { href: '/free-invoicing-software', label: t('mega.allFeatures') },
    { href: '/glossary', label: t('nav.glossary') },
  ]}
/>
